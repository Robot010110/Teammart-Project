# Copy this file to .env.
#
# VITE_API_URL is OPTIONAL for local development. Left unset, the app
# derives the API URL from the host the frontend was loaded from, on port
# 4000 — see resolveApiBaseUrl() in src/services/apiClient.js:
#
#   desktop  http://localhost:5173      -> http://localhost:4000/api
#   phone    http://<laptop-ip>:5173    -> http://<laptop-ip>:4000/api
#
# That makes LAN testing on a real phone work with no configuration, and
# survive the laptop's IP changing.
#
# Set it explicitly when the backend is NOT on the same host as the
# frontend, which includes every real deployment:
# VITE_API_URL=https://api.your-domain.com/api
