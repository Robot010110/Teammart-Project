// Prisma schema for TEAMMART.
//
// This is an evolution of the original schema. It keeps the same core
// idea (Zone -> Market -> Employee) but adds what the new frontend
// (teammart_draft_1) actually needs:
//   - Three real login types: staff (Admin / Regional Manager / Supervisor)
//     and Employees (who log in with an employee code, not an email).
//   - A Market now has its own Supervisor (not just a Zone manager).
//   - A Task model for the daily-activity submission/approval workflow.
//
// Naming note: the OLD schema called the top staff role
// "REGIONAL_SUPERVISOR" and had a "ZONE_MANAGER". The frontend actually
// has three different people: Admin, Regional Manager (zone-scoped), and
// Supervisor (market-scoped). We renamed the enum to match the frontend
// exactly, so there is one shared vocabulary across the whole stack.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------

// Staff roles. Employees are NOT part of this enum — they are a separate
// model with their own login, because in the frontend they are a
// fundamentally different kind of account (scoped to just themselves).
enum StaffRole {
  ADMIN
  REGIONAL_MANAGER
  SUPERVISOR
}

enum MarketStatus {
  ACTIVE
  MAINTENANCE
  CLOSED
}

// Mirrors the frontend's TASK_SUBMISSION_OPTIONS / ACTIVITY_TYPES.
enum TaskType {
  FACING
  REFILLING
  DEPARTMENT_PHOTO
  WASTE_ITEMS
  SHELF_CLEANING
  CHECKING_LABELS
  COUNTING_ITEMS
  CUSTOMIZATION
}

// ASSIGNED      -> a supervisor/manager created this task for an employee, not started yet
// PENDING       -> employee submitted work, waiting for a supervisor to review it
// APPROVED      -> reviewed and accepted
// REJECTED      -> reviewed and sent back (see rejectionReason)
enum TaskStatus {
  ASSIGNED
  PENDING
  APPROVED
  REJECTED
}

// ---------------------------------------------------------------------
// Activity — Phase 1, Step 3. Categories an employee's own daily activity
// log can belong to. One reusable model + this enum stands in for what
// would otherwise be six near-identical tables (ShelfCleaning,
// LabelChecking, Inventory, DailyCleaning, ...). Adding a new category
// later is a one-line enum change instead of a new table + migration +
// new controller.
enum ActivityCategory {
  EXPIRED_ITEMS
  SHELF_CLEANING
  PRODUCT_CUSTOMIZATION
  DAILY_CLEANING
  ITEM_COUNTING
  LABEL_CHECKING
  FACING
  REFILLING
}

// Only meaningful when Activity.category = LABEL_CHECKING — what's wrong
// with the label the employee found (spec: Missing/Incorrect/Damaged).
enum LabelIssueType {
  MISSING
  INCORRECT
  DAMAGED
}

// Deliberately only these four values (Step 4 spec). Note this is a
// SEPARATE enum from TaskStatus even though they share three names —
// Activity has no "ASSIGNED" state because an employee logs their own
// activity, nobody assigns it to them (that concept stays on Task).
// DRAFT   -> employee started an entry but hasn't submitted it yet
// PENDING -> submitted, waiting for a supervisor to review it (later)
// APPROVED / REJECTED -> reviewed (review endpoints are NOT built yet —
// this module only lets an employee reach DRAFT/PENDING themselves)
enum ActivityStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

// ---------------------------------------------------------------------
// SuddenTask — a Supervisor/Manager/Admin pushing an urgent, ASAP task to
// an employee. Deliberately its own model, not a reuse of Task: Task's
// `type` field is an enum of activity-shaped categories (FACING,
// REFILLING, ...) meant for the daily-activity submission flow, whereas a
// Sudden Task is a freeform title/description with a priority — a
// different shape for a different purpose. Also deliberately not merged
// into Activity, which is "an employee logging their own work", not
// "a supervisor pushing urgent work at an employee".
enum SuddenTaskPriority {
  NORMAL
  HIGH
  URGENT
}

// ASSIGNED  -> pushed to the employee, not done yet
// COMPLETED -> employee marked it done
enum SuddenTaskStatus {
  ASSIGNED
  COMPLETED
}

// ---------------------------------------------------------------------
// Expired & Wasted Items — an employee identifies a Product (barcode scan
// or photo -> manual product search, see itemReportsController.js for
// why there's no real AI photo recognition here) and reports it as no
// longer sellable. Deliberately its own model, not folded into Activity:
// this has a Product link + quantity + an automatic stock side-effect
// that no other Activity category needs.
// ---------------------------------------------------------------------
enum ItemCondition {
  EXPIRED
  WASTED
}

// ---------------------------------------------------------------------
// Attendance — worked hours are NOT a Task or Activity; they're a
// separate concern entirely. Check-in/out, breaks, shift, day-off, and
// reward/extra/penalty-hour tracking, imported from the company's
// attendance system rather than entered by the employee (see
// attendanceController.js for the CSV-import approach used in place of
// a live fingerprint-device feed).
// ---------------------------------------------------------------------
enum Shift {
  MORNING // 8:00 AM - 4:00 PM
  EVENING // 4:00 PM - 12:00 AM
  NIGHT   // 12:00 AM - 8:00 AM
}

enum AttendanceStatus {
  PRESENT
  LATE
  EARLY_LEAVE
  ABSENT
  DAY_OFF
  APPROVED_LEAVE
  INCOMPLETE
  PENDING_REVIEW
}

enum DayOffType {
  WEEKLY
  MONTHLY
  OTHER
}

// IMPORT  -> written by the Excel attendance import
// MANUAL  -> written directly by a staff member (no import row backing it)
// SYSTEM  -> written by the app itself (e.g. a LeaveRequest approval)
enum AttendanceSource {
  IMPORT
  MANUAL
  SYSTEM
}

enum LeaveRequestType {
  MONTHLY_OFF
  PERSONAL_LEAVE
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// ---------------------------------------------------------------------
// Cashier role — a second, genuinely different kind of Employee (own
// login identifier, own profile fields, own shift-gated feature set).
// Both WORKER and CASHIER are still the same Employee model/JWT `kind`,
// so every existing employee-scoped endpoint (Activities, Sudden Tasks,
// Attendance, Item Reports) keeps working for a Cashier token unchanged
// — only the two Cashier-only modules below (Cleaning, Price Report) are
// new. See cashierCleaningController.js / priceReportsController.js.
// ---------------------------------------------------------------------
enum EmployeeRole {
  WORKER
  CASHIER
}

// Only two values for Cashiers (unlike the three-shift Shift enum used by
// Attendance) — deliberately its own enum, not a reuse of `Shift`, since
// Cashiers are never on a Night shift per the spec.
enum CashierShift {
  MORNING
  EVENING
}

enum EmploymentStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
}

// ---------------------------------------------------------------------
// Notifications — a real, generic feed (previously just a TODO comment
// in EmployeeWorkspace.jsx: "this toast is NOT a real notification
// system"). Written by the concrete actions that already exist: Sudden
// Task assignment, Leave request review, a new Chat message. Not wired
// into review steps that don't exist yet (e.g. Item Reports have no
// review endpoint) — no invented triggers.
// ---------------------------------------------------------------------
enum NotificationType {
  SUDDEN_TASK
  LEAVE_REVIEWED
  CHAT_MESSAGE
  ANNOUNCEMENT
}

// ---------------------------------------------------------------------
// Chat — market-scoped: one Market Group conversation, one Warnings
// (supervisor-announcement, employee-read-only) conversation, and any
// number of Direct 1:1 conversations between two employees in the same
// market. Polling-based (no WebSocket dependency — see
// chatController.js's listMessages ?after= param), consistent with the
// rest of this app's REST-only architecture.
// ---------------------------------------------------------------------
enum ConversationType {
  MARKET_GROUP
  WARNINGS
  DIRECT
}

// ---------------------------------------------------------------------
// Staff (Admin / Regional Manager / Supervisor) — logs in with email
// ---------------------------------------------------------------------
model User {
  id           Int       @id @default(autoincrement())
  name         String
  email        String    @unique
  passwordHash String
  role         StaffRole @default(SUPERVISOR)
  createdAt    DateTime  @default(now())

  // A Regional Manager manages exactly one zone.
  managedZone   Zone?    @relation("ZoneManager")
  // A Supervisor manages exactly one market.
  managedMarket Market?  @relation("MarketSupervisor")

  // Tasks this staff member has reviewed (approved/rejected).
  reviewedTasks Task[] @relation("TaskReviewer")
  // Tasks this staff member proactively assigned to an employee.
  assignedTasks Task[] @relation("TaskAssigner")

  // Sudden Tasks this staff member has pushed to an employee.
  assignedSuddenTasks SuddenTask[] @relation("SuddenTaskAssigner")

  // Products this staff member added to a market's inventory.
  createdProducts Product[] @relation("ProductCreator")

  // Attendance rows this staff member imported directly (legacy single-row
  // path — the real Excel import now goes through AttendanceImportBatch).
  importedAttendance AttendanceRecord[] @relation("AttendanceImporter")

  requiredHoursAdjustments AttendanceAuditLog[]       @relation("AttendanceAuditor")
  adjustedRequiredHours    RequiredHoursAdjustment[]  @relation("RequiredHoursAdjuster")
  uploadedAttendanceImports AttendanceImportBatch[]   @relation("AttendanceImportUploader")
  reviewedLeaveRequests    LeaveRequest[]             @relation("LeaveReviewer")
  assignedDepartments      DepartmentAssignment[]     @relation("DepartmentAssigner")

  sentMessages Message[] @relation("MessageSenderUser")
}

// ---------------------------------------------------------------------
// Zone -> Market -> Employee
// ---------------------------------------------------------------------
model Zone {
  id        Int      @id @default(autoincrement())
  number    Int      @unique
  managerId Int?     @unique
  manager   User?    @relation("ZoneManager", fields: [managerId], references: [id])
  markets   Market[]
  createdAt DateTime @default(now())
}

model Market {
  id           String       @id @default(cuid())
  name         String
  status       MarketStatus @default(ACTIVE)
  zoneId       Int
  zone         Zone         @relation(fields: [zoneId], references: [id])
  supervisorId Int?         @unique
  supervisor   User?        @relation("MarketSupervisor", fields: [supervisorId], references: [id])
  employees    Employee[]
  tasks        Task[]
  suddenTasks  SuddenTask[]
  products     Product[]
  itemReports  ItemReport[]
  priceReports PriceReport[]
  leaveRequests LeaveRequest[]
  attendanceImportBatches AttendanceImportBatch[]
  conversations Conversation[]
  createdAt    DateTime     @default(now())

  @@index([zoneId])
}

// Employees log in with an employeeCode + password, not an email — this
// matches the frontend's "find yourself" login flow for the Employee role.
model Employee {
  id            String       @id @default(cuid())
  employeeCode  String       @unique
  name          String
  passwordHash  String
  position      String
  secondaryRole String?
  shift         String?
  role          EmployeeRole @default(WORKER)
  marketId      String
  market        Market       @relation(fields: [marketId], references: [id])
  tasks         Task[]
  createdAt     DateTime     @default(now())

  // --- Employee Profile fields (Phase 1, Step 2) ---
  // All nullable/optional so existing employee rows don't break and none
  // of these are calculated yet — they're just places to store the data
  // once the matching feature (photo upload, real performance calc) exists.
  profilePictureUrl String?   // URL of an uploaded photo; no upload feature yet.
  startDate         DateTime? // The employee's real hire date (different from
                               // createdAt, which is just "when the DB row
                               // was created" and may not match reality).
  performanceRate   Int?      // Placeholder for a future calculated score.
                               // Nothing writes to this yet — see Step 7.

  // username/cashierShift stay Cashier-only (null for a WORKER) — separate
  // login identifier namespace, a Worker keeps logging in with employeeCode.
  username     String?       @unique
  cashierShift CashierShift? // drives whether Cleaning is shown

  // department applies to EVERY employee now (Worker or Cashier) — kept
  // as a fast denormalized "current department" cache, synced whenever a
  // new DepartmentAssignment is created; that table is the historical
  // source of truth (see DepartmentAssignment below).
  department       String?
  employmentStatus EmploymentStatus @default(ACTIVE)
  whatsappNumber   String?                   // tap-to-open wa.me link on the profile

  activities Activity[]
  suddenTasks SuddenTask[]
  itemReports ItemReport[]
  attendanceRecords         AttendanceRecord[]
  requiredHoursAdjustments  RequiredHoursAdjustment[]
  cashierCleaningLogs       CashierCleaningLog[]
  priceReports              PriceReport[]
  leaveRequests             LeaveRequest[]
  departmentAssignments     DepartmentAssignment[]
  auditLogEntries           AttendanceAuditLog[]

  notifications         Notification[]
  sentMessages          Message[]          @relation("MessageSenderEmployee")
  conversationReads     ConversationRead[]
  directConversationsAsA Conversation[]    @relation("ConversationParticipantA")
  directConversationsAsB Conversation[]    @relation("ConversationParticipantB")

  @@index([marketId])
}

// ---------------------------------------------------------------------
// Task — the daily-activity submission / assignment / review workflow.
//
// NOTE: as of the Sudden Tasks module, this model has no frontend caller
// anywhere (no `taskService.js` exists) even though every endpoint below
// is implemented and tested. It was NOT reused for Sudden Tasks because
// `type` is an activity-shaped enum (FACING/REFILLING/...), not a
// freeform title+description+priority. Leaving this here unused rather
// than deleting it — it's a reasonable base for a future "Supervisor
// assigns a normal activity-shaped task" feature, but that's a decision
// for whoever builds the Supervisor module, not this change.
// ---------------------------------------------------------------------
model Task {
  id         String     @id @default(cuid())
  type       TaskType
  label      String
  department String
  notes      String?
  status     TaskStatus @default(PENDING)

  requiresPhoto  Boolean @default(false)
  // No file upload service is wired up yet — these hold a URL/path once
  // one exists. Left nullable so the API works before that's built.
  beforePhotoUrl String?
  afterPhotoUrl  String?

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  marketId   String
  market     Market   @relation(fields: [marketId], references: [id])

  // Set when a supervisor/manager proactively assigns this task instead
  // of the employee submitting it on their own initiative.
  assignedById Int?
  assignedBy   User?   @relation("TaskAssigner", fields: [assignedById], references: [id])

  reviewedById     Int?
  reviewedBy       User?     @relation("TaskReviewer", fields: [reviewedById], references: [id])
  rejectionReason  String?
  reviewedAt       DateTime?

  submittedAt DateTime  @default(now())
  createdAt   DateTime  @default(now())

  @@index([employeeId])
  @@index([marketId])
  @@index([status])
}

// ---------------------------------------------------------------------
// Activity — an employee's own daily activity log (Phase 1, Step 3/4).
// This is intentionally separate from Task: Task is "a supervisor gave
// me work to do", Activity is "I'm logging work I did on my own". Same
// review lifecycle shape (submit -> approve/reject) but a different
// reason for existing, so we do not merge them (Step 6).
model Activity {
  id       String           @id @default(cuid())
  category ActivityCategory
  date     DateTime
  time     String // e.g. "9:15 AM" — stored as text to mirror what the
                   // frontend already generates; no timezone-math is
                   // needed for a simple "what time did this happen" label.
  notes    String?
  status   ActivityStatus @default(DRAFT)

  // Only meaningful for category = LABEL_CHECKING — the scanned/searched
  // Product the label issue was found on (same product-search flow as
  // ItemReport), and what's wrong with it. Null for every other category.
  productId      String?
  product        Product?        @relation(fields: [productId], references: [id])
  labelIssueType LabelIssueType?

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  images ActivityImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([status])
}

// One Activity can have many images, and each image belongs to exactly
// one Activity (Step 5) — instead of fixed photo1/photo2/photo3 columns
// on Activity, which would cap how many images an activity can ever have
// and waste columns whenever there are fewer. This scales to any number
// of images with no future schema change.
model ActivityImage {
  id  String @id @default(cuid())
  url String

  activityId String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([activityId])
}

// ---------------------------------------------------------------------
// SuddenTask — a Supervisor/Manager/Admin pushing an urgent task at an
// employee (see the SuddenTaskPriority/SuddenTaskStatus comment above for
// why this is its own model, separate from both Task and Activity).
// ---------------------------------------------------------------------
model SuddenTask {
  id          String             @id @default(cuid())
  title       String
  description String
  priority    SuddenTaskPriority @default(NORMAL)
  status      SuddenTaskStatus   @default(ASSIGNED)
  // Set by completeSuddenTask when the supervisor requires photo evidence
  // — previously completion was a bare status flip with nowhere to put
  // the photo the spec explicitly asks for.
  evidenceUrl String?

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  marketId   String
  market     Market   @relation(fields: [marketId], references: [id])

  assignedById Int
  assignedBy   User   @relation("SuddenTaskAssigner", fields: [assignedById], references: [id])

  assignedAt  DateTime  @default(now())
  completedAt DateTime?

  @@index([employeeId])
  @@index([marketId])
  @@index([status])
}

// ---------------------------------------------------------------------
// Product — a minimal per-market inventory catalog, just enough to back
// the Expired/Wasted Items report-and-decrement flow. No real
// Inventory/Indent Management system exists to integrate with, so this
// is the system of record for stock quantity until one does.
// ---------------------------------------------------------------------
model Product {
  id            String   @id @default(cuid())
  barcode       String
  name          String
  stockQuantity Int      @default(0)

  marketId String
  market   Market @relation(fields: [marketId], references: [id])

  createdById Int
  createdBy   User @relation("ProductCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  itemReports ItemReport[]
  labelActivities Activity[]

  // Same barcode can be separate stock in different markets, so the
  // uniqueness is per-market, not global.
  @@unique([barcode, marketId])
  @@index([marketId])
}

// ItemReport — an employee reporting a Product as expired or wasted.
// Submitting one immediately decrements Product.stockQuantity in the
// same transaction (see itemReportsController.js) — no manual inventory
// adjustment from a supervisor required, per the spec. `status` exists
// for audit/review purposes only; it does not gate the stock decrement.
model ItemReport {
  id          String         @id @default(cuid())
  condition   ItemCondition
  quantity    Int
  status      ActivityStatus @default(PENDING)
  notes       String?
  imageUrl    String?

  productId String
  product   Product @relation(fields: [productId], references: [id])

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  marketId   String
  market     Market   @relation(fields: [marketId], references: [id])

  reportedAt DateTime @default(now())

  @@index([employeeId])
  @@index([productId])
  @@index([marketId])
  @@index([reportedAt])
}

// ---------------------------------------------------------------------
// AttendanceRecord — one employee's attendance for one day: status,
// shift, check-in/out, break times, and required hours for that day.
// Populated by importAttendanceRecords (a staff-side Excel import — see
// attendanceController.js) rather than a live fingerprint-device feed,
// which isn't reachable from this app. Working hours are computed from
// checkIn/checkOut/break, not stored, so there's no redundant derived
// value to drift out of sync — requiredHours IS stored (not computed)
// because it's a real, independently-set value (default 8, overridable
// per day by a RequiredHoursAdjustment), not derived from anything else.
// ---------------------------------------------------------------------
model AttendanceRecord {
  id            String           @id @default(cuid())
  date          DateTime // the day this record is for; time part is ignored
  status        AttendanceStatus @default(PRESENT)
  shift         Shift?
  checkIn       DateTime?
  checkOut      DateTime?
  breakStart    DateTime?
  breakEnd      DateTime?
  dayOffType    DayOffType? // only meaningful when status = DAY_OFF
  requiredHours Int              @default(8) // 0-16, enforced in validate.js
  source        AttendanceSource @default(MANUAL)
  // The original imported row, preserved verbatim for audit purposes
  // (spec: "Preserve the original imported data") — only set when
  // source = IMPORT.
  rawImportData Json?

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  importedById Int?
  importedBy   User? @relation("AttendanceImporter", fields: [importedById], references: [id])

  importBatchId String?
  importBatch   AttendanceImportBatch? @relation(fields: [importBatchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One record per employee per day — makes re-importing the same export
  // file idempotent (upsert on this constraint) instead of duplicating rows.
  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([date])
}

// RequiredHoursAdjustment — a supervisor's override of an employee's
// required hours for one specific date (e.g. "8 -> 7, reward for
// exceptional performance"). Kept as its own append-only history table
// (never edited/deleted) so the full previous/new/reason/who/when trail
// survives even though AttendanceRecord.requiredHours itself is mutable
// (always reflects the CURRENT value). Replaces the earlier
// REWARD/EXTRA/PENALTY hour-delta model — that shape never matched what
// this spec actually needs (a direct override, not a delta), and nothing
// depended on the old shape (no Supervisor UI ever created one).
model RequiredHoursAdjustment {
  id                    String   @id @default(cuid())
  date                  DateTime // the day this adjustment applies to
  previousRequiredHours Int
  newRequiredHours      Int // 0-16, enforced in validate.js
  reason                String

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  adjustedById Int
  adjustedBy   User @relation("RequiredHoursAdjuster", fields: [adjustedById], references: [id])

  createdAt DateTime @default(now())

  @@index([employeeId])
  @@index([date])
}

// AttendanceImportBatch — one row per Excel attendance import, tracking
// who/when/how-many so every import is auditable and repeat-safe (spec
// §5/§16). AttendanceRecord.importBatchId links every record the batch
// touched back to it.
model AttendanceImportBatch {
  id             String   @id @default(cuid())
  fileName       String?
  periodStart    DateTime
  periodEnd      DateTime
  totalRecords   Int
  createdCount   Int
  updatedCount   Int
  unmatchedCount Int
  rejectedCount  Int
  errors         Json // [{ row, employeeCode?, message }]
  importedAt     DateTime @default(now())

  marketId String
  market   Market @relation(fields: [marketId], references: [id])

  uploadedById Int
  uploadedBy   User @relation("AttendanceImportUploader", fields: [uploadedById], references: [id])

  records AttendanceRecord[]

  @@index([marketId])
}

// LeaveRequest — an employee requesting a Monthly Off day or Personal
// Leave for a specific date, reviewed by their Supervisor. Approving one
// upserts the matching AttendanceRecord (DAY_OFF or APPROVED_LEAVE) in
// the same transaction, so the calendar never shows a conflicting
// "Present" day for an approved leave (spec §11).
model LeaveRequest {
  id          String              @id @default(cuid())
  date        DateTime
  type        LeaveRequestType
  reason      String? // required for PERSONAL_LEAVE, enforced in validate.js
  status      LeaveRequestStatus  @default(PENDING)
  submittedAt DateTime            @default(now())

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  marketId   String // denormalized for the Supervisor review-queue query
  market     Market  @relation(fields: [marketId], references: [id])

  reviewedById Int?
  reviewedBy   User?     @relation("LeaveReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  reviewNote   String?

  // One request per employee per date — a second submission for the same
  // day is a clean 409 (existing errorHandler.js P2002 handling), not a
  // duplicate row.
  @@unique([employeeId, date])
  @@index([marketId])
  @@index([status])
}

// AttendanceAuditLog — generic audit trail for attendance-adjacent
// mutations (required-hours adjustments, leave approve/reject, imports,
// future manual corrections). One row per action, append-only. Spec §13
// asks for exactly this: who, what changed, previous value, new value,
// reason, when.
model AttendanceAuditLog {
  id     String @id @default(cuid())
  action String // "REQUIRED_HOURS_ADJUSTED" | "LEAVE_APPROVED" | "LEAVE_REJECTED" | "ATTENDANCE_IMPORTED" | ...

  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id])

  performedById Int
  performedBy   User @relation("AttendanceAuditor", fields: [performedById], references: [id])

  previousValue Json?
  newValue      Json?
  reason        String?

  createdAt DateTime @default(now())

  @@index([employeeId])
  @@index([createdAt])
}

// DepartmentAssignment — history of which department an employee belonged
// to and when (spec §3: "store department assignment history"). Applies
// to every employee (Worker or Cashier). Employee.department is kept as
// a fast denormalized cache of whichever assignment has endDate = null
// (the current one); this table is the source of truth for "what
// department were they in on date X".
model DepartmentAssignment {
  id         String    @id @default(cuid())
  department String
  startDate  DateTime  @default(now())
  endDate    DateTime? // set when the NEXT assignment starts; null = current

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  assignedById Int
  assignedBy   User @relation("DepartmentAssigner", fields: [assignedById], references: [id])

  @@index([employeeId])
}

// ---------------------------------------------------------------------
// CashierCleaningLog — one row per cashier per day, station-cleaning
// checklist. Deliberately NOT the same thing as Activity's SHELF_CLEANING
// category: this always means "clean the cashier station", never shelf/
// aisle/department cleaning, and only Morning-shift cashiers see this
// page at all (see cashierCleaningController.js). `items` is a JSON
// snapshot of the fixed checklist (label + checked) rather than a child
// table — the checklist is a small, fixed set of labels defined on the
// frontend, not independently queryable/reportable data.
// ---------------------------------------------------------------------
model CashierCleaningLog {
  id          String    @id @default(cuid())
  date        DateTime // the day this applies to; time part ignored
  items       Json // [{ label: string, checked: boolean }]
  completedAt DateTime?

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One log per cashier per day — same idempotent-upsert idiom as
  // AttendanceRecord.
  @@unique([employeeId, date])
  @@index([employeeId])
}

// ---------------------------------------------------------------------
// PriceReport — a cashier flagging a shelf-price vs. POS-system-price
// mismatch. Its own model, not ItemReport: no product/inventory link or
// stock side-effect, just two prices, an optional photo, and a route to
// the Supervisor for review (see priceReportsController.js — "send to
// the Supervisor" means the report is immediately visible to any
// Supervisor of this market, since no push-notification system exists
// anywhere in this app).
// ---------------------------------------------------------------------
model PriceReport {
  id          String         @id @default(cuid())
  productName String
  barcode     String?
  shelfPrice  Float
  systemPrice Float
  notes       String?
  photoUrl    String?
  shift       CashierShift? // the cashier's shift at the time of reporting
  status      ActivityStatus @default(PENDING)

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  marketId   String
  market     Market   @relation(fields: [marketId], references: [id])

  reportedAt DateTime @default(now())

  @@index([employeeId])
  @@index([marketId])
  @@index([reportedAt])
}

// ---------------------------------------------------------------------
// Notification — a real feed, replacing what used to be just a
// TODO comment ("this toast is NOT a real notification system") in
// EmployeeWorkspace.jsx. See the NotificationType comment above for
// which concrete actions write one.
// ---------------------------------------------------------------------
model Notification {
  id    String           @id @default(cuid())
  type  NotificationType
  title String
  body  String
  read  Boolean          @default(false)

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  // Lets the frontend route to the right screen on tap without parsing
  // `body` — e.g. linkType "SUDDEN_TASK" + linkId = that task's id.
  linkType String?
  linkId   String?

  createdAt DateTime @default(now())

  @@index([employeeId, read])
}

// ---------------------------------------------------------------------
// Conversation — one per Market Group, one per Warnings channel, and one
// per Direct pair of employees. Group/Warnings are found-or-created in
// chatController.js (see the ConversationType comment above for why that
// can't be a bare DB constraint); Direct relies on the unique index below
// with participantAId/participantBId always stored in a consistent order
// (enforced in the controller) so the same pair never gets two rows.
// ---------------------------------------------------------------------
model Conversation {
  id   String           @id @default(cuid())
  type ConversationType

  marketId String
  market   Market @relation(fields: [marketId], references: [id])

  participantAId String?
  participantA   Employee? @relation("ConversationParticipantA", fields: [participantAId], references: [id])
  participantBId String?
  participantB   Employee? @relation("ConversationParticipantB", fields: [participantBId], references: [id])

  createdAt DateTime @default(now())

  messages Message[]
  reads    ConversationRead[]

  @@unique([marketId, type, participantAId, participantBId])
  @@index([marketId])
}

// Message — sender is EITHER an Employee OR a staff User (Warnings
// broadcasts come from staff), never both; enforced in chatController.js,
// not at the DB layer, since Prisma has no native "exactly one of two
// nullable FKs" constraint.
model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  body     String
  imageUrl String?

  senderEmployeeId String?
  senderEmployee   Employee? @relation("MessageSenderEmployee", fields: [senderEmployeeId], references: [id])
  senderUserId     Int?
  senderUser       User?     @relation("MessageSenderUser", fields: [senderUserId], references: [id])

  createdAt DateTime @default(now())

  @@index([conversationId, createdAt])
}

// ConversationRead — one row per (conversation, employee), tracking read
// position. Unread count = messages in that conversation created after
// lastReadAt (or every message, if no row exists yet — never opened).
model ConversationRead {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  employeeId     String
  employee       Employee     @relation(fields: [employeeId], references: [id])
  lastReadAt     DateTime     @default(now())

  @@unique([conversationId, employeeId])
}
