// Prisma schema for TEAMMART.
//
// This is an evolution of the original schema. It keeps the same core
// idea (Zone -> Market -> Employee) but adds what the new frontend
// (teammart_draft_1) actually needs:
//   - Three real login types: staff (Admin / Regional Manager / Supervisor)
//     and Employees (who log in with an employee code, not an email).
//   - A Market now has its own Supervisor (not just a Zone manager).
//   - A Task model for the daily-activity submission/approval workflow.
//
// Naming note: the OLD schema called the top staff role
// "REGIONAL_SUPERVISOR" and had a "ZONE_MANAGER". The frontend actually
// has three different people: Admin, Regional Manager (zone-scoped), and
// Supervisor (market-scoped). We renamed the enum to match the frontend
// exactly, so there is one shared vocabulary across the whole stack.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------

// Staff roles. Employees are NOT part of this enum — they are a separate
// model with their own login, because in the frontend they are a
// fundamentally different kind of account (scoped to just themselves).
enum StaffRole {
  ADMIN
  REGIONAL_MANAGER
  SUPERVISOR
  // A market's Night/Evening shift counterpart to its SUPERVISOR — its
  // own real account (Market.overlookingSupervisorId), not a shift label
  // on the Supervisor login (see Market's own comment). Has a narrower
  // permission set than SUPERVISOR: e.g. can submit Card Sales but not
  // Total Sales (see totalSalesController.js / cardSalesController.js).
  OVERLOOKING_SUPERVISOR
}

enum MarketStatus {
  ACTIVE
  MAINTENANCE
  CLOSED
}

// Mirrors the frontend's TASK_SUBMISSION_OPTIONS / ACTIVITY_TYPES.
enum TaskType {
  FACING
  REFILLING
  DEPARTMENT_PHOTO
  WASTE_ITEMS
  SHELF_CLEANING
  CHECKING_LABELS
  COUNTING_ITEMS
  CUSTOMIZATION
}

// ASSIGNED      -> a supervisor/manager created this task for an employee, not started yet
// PENDING       -> employee submitted work, waiting for a supervisor to review it
// APPROVED      -> reviewed and accepted
// REJECTED      -> reviewed and sent back (see rejectionReason)
enum TaskStatus {
  ASSIGNED
  PENDING
  APPROVED
  REJECTED
}

// ---------------------------------------------------------------------
// Activity — Phase 1, Step 3. Categories an employee's own daily activity
// log can belong to. One reusable model + this enum stands in for what
// would otherwise be six near-identical tables (ShelfCleaning,
// LabelChecking, Inventory, DailyCleaning, ...). Adding a new category
// later is a one-line enum change instead of a new table + migration +
// new controller.
enum ActivityCategory {
  EXPIRED_ITEMS
  SHELF_CLEANING
  PRODUCT_CUSTOMIZATION
  DAILY_CLEANING
  ITEM_COUNTING
  LABEL_CHECKING
  FACING
  REFILLING
}

// Only meaningful when Activity.category = LABEL_CHECKING — what's wrong
// with the label the employee found (spec: Missing/Incorrect/Damaged).
enum LabelIssueType {
  MISSING
  INCORRECT
  DAMAGED
}

// Deliberately only these four values (Step 4 spec). Note this is a
// SEPARATE enum from TaskStatus even though they share three names —
// Activity has no "ASSIGNED" state because an employee logs their own
// activity, nobody assigns it to them (that concept stays on Task).
// DRAFT   -> employee started an entry but hasn't submitted it yet
// PENDING -> submitted, waiting for a supervisor to review it (later)
// APPROVED / REJECTED -> reviewed (review endpoints are NOT built yet —
// this module only lets an employee reach DRAFT/PENDING themselves)
enum ActivityStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

// ---------------------------------------------------------------------
// SuddenTask — a Supervisor/Manager/Admin pushing an urgent, ASAP task to
// an employee. Deliberately its own model, not a reuse of Task: Task's
// `type` field is an enum of activity-shaped categories (FACING,
// REFILLING, ...) meant for the daily-activity submission flow, whereas a
// Sudden Task is a freeform title/description with a priority — a
// different shape for a different purpose. Also deliberately not merged
// into Activity, which is "an employee logging their own work", not
// "a supervisor pushing urgent work at an employee".
enum SuddenTaskPriority {
  NORMAL
  HIGH
  URGENT
}

// ASSIGNED  -> pushed to the employee, not done yet
// COMPLETED -> employee marked it done
enum SuddenTaskStatus {
  ASSIGNED
  COMPLETED
}

// ---------------------------------------------------------------------
// Expired & Wasted Items — an employee identifies a Product (barcode scan
// or photo -> manual product search, see itemReportsController.js for
// why there's no real AI photo recognition here) and reports it as no
// longer sellable. Deliberately its own model, not folded into Activity:
// this has a Product link + quantity + an automatic stock side-effect
// that no other Activity category needs.
// ---------------------------------------------------------------------
enum ItemCondition {
  EXPIRED
  WASTED
}

// ---------------------------------------------------------------------
// Attendance — worked hours are NOT a Task or Activity; they're a
// separate concern entirely. Check-in/out, breaks, shift, day-off, and
// reward/extra/penalty-hour tracking, imported from the company's
// attendance system rather than entered by the employee (see
// attendanceController.js for the CSV-import approach used in place of
// a live fingerprint-device feed).
// ---------------------------------------------------------------------
enum Shift {
  MORNING // 8:00 AM - 4:00 PM
  EVENING // 4:00 PM - 12:00 AM
  NIGHT   // 12:00 AM - 8:00 AM
}

enum AttendanceStatus {
  PRESENT
  LATE
  EARLY_LEAVE
  ABSENT
  DAY_OFF
  APPROVED_LEAVE
  INCOMPLETE
  PENDING_REVIEW
}

enum DayOffType {
  WEEKLY
  MONTHLY
  OTHER
}

// IMPORT  -> written by the Excel attendance import
// MANUAL  -> written directly by a staff member (no import row backing it)
// SYSTEM  -> written by the app itself (e.g. a LeaveRequest approval)
enum AttendanceSource {
  IMPORT
  MANUAL
  SYSTEM
}

enum LeaveRequestType {
  MONTHLY_OFF
  PERSONAL_LEAVE
  // A day off funded by an employee's accumulated extra-work-hours
  // balance (8 banked extra hours = 1 day off), instead of an
  // employer-granted monthly off day or unpaid personal leave. See
  // LeaveRequest.hoursSpent and attendanceController's balance
  // computation — there is no separate ledger table; the balance is
  // always derived from AttendanceRecord vs. already-APPROVED
  // EARNED_DAY_OFF requests, same "never store what can be computed"
  // convention as workingHours/attendanceRate.
  EARNED_DAY_OFF
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// ---------------------------------------------------------------------
// Cashier role — a second, genuinely different kind of Employee (own
// login identifier, own profile fields, own shift-gated feature set).
// Both WORKER and CASHIER are still the same Employee model/JWT `kind`,
// so every existing employee-scoped endpoint (Activities, Sudden Tasks,
// Attendance, Item Reports) keeps working for a Cashier token unchanged
// — only the two Cashier-only modules below (Cleaning, Price Report) are
// new. See cashierCleaningController.js / priceReportsController.js.
// ---------------------------------------------------------------------
enum EmployeeRole {
  WORKER
  CASHIER
  BUTCHER
}

// Only two values for Cashiers (unlike the three-shift Shift enum used by
// Attendance) — deliberately its own enum, not a reuse of `Shift`, since
// Cashiers are never on a Night shift per the spec.
enum CashierShift {
  MORNING
  EVENING
}

enum EmploymentStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
}

// ---------------------------------------------------------------------
// Notifications — a real, generic feed (previously just a TODO comment
// in EmployeeWorkspace.jsx: "this toast is NOT a real notification
// system"). Written by the concrete actions that already exist: Sudden
// Task assignment, Leave request review, a new Chat message. Not wired
// into review steps that don't exist yet (e.g. Item Reports have no
// review endpoint) — no invented triggers.
// ---------------------------------------------------------------------
enum NotificationType {
  SUDDEN_TASK
  LEAVE_REVIEWED
  CHAT_MESSAGE
  ANNOUNCEMENT
  WASTED_OVERALL
  // A Supervisor approved/rejected an employee's Activity or Wasted
  // Overall report — one shared type for both, same as LEAVE_REVIEWED
  // covers both leave outcomes.
  SUBMISSION_REVIEWED
  // A Regional Manager sent a formal Warning or Recognition to a
  // market's Supervisor (MarketFeedback) — one shared type for both,
  // same reasoning as SUBMISSION_REVIEWED/LEAVE_REVIEWED above.
  MARKET_FEEDBACK
  // An employee submitted an AttendanceAdjustmentRequest (extra hours) —
  // notifies their market's Supervisor. The Supervisor's approve/reject
  // outcome reuses SUBMISSION_REVIEWED going back to the employee.
  EXTRA_HOURS_SUBMITTED
  // A Supervisor submitted a Total Sales report — notifies the market's
  // Regional Manager(s), the only role authorized to view it.
  TOTAL_SALES_SUBMITTED
  // A Supervisor or Overlooking account submitted a Card Sales report for
  // one shift — notifies the market's Regional Manager(s).
  CARD_SALES_SUBMITTED
}

// ---------------------------------------------------------------------
// Chat — market-scoped: one Market Group conversation, one Warnings
// (supervisor-announcement, employee-read-only) conversation, and any
// number of Direct 1:1 conversations between two employees in the same
// market. Polling-based (no WebSocket dependency — see
// chatController.js's listMessages ?after= param), consistent with the
// rest of this app's REST-only architecture.
// ---------------------------------------------------------------------
enum ConversationType {
  MARKET_GROUP
  WARNINGS
  DIRECT
  // A real, backend-persisted 1:1 conversation between one Employee and
  // their market's Supervisor (a staff User) — DIRECT above only ever
  // connects two Employees (participantAId/participantBId are both
  // Employee FKs), so it structurally cannot represent an Employee<->
  // Supervisor DM. This type uses participantAId (the Employee) +
  // staffParticipantId (the Supervisor's User id) instead.
  SUPERVISOR_DIRECT
  // Same shape as SUPERVISOR_DIRECT (participantAId = Employee,
  // staffParticipantId = the Regional Manager's User id) but with an
  // extra rule SUPERVISOR_DIRECT doesn't have: the employee can't
  // initiate it, and can't reply until the RM sends the first message —
  // see Conversation.locked below.
  RM_DIRECT
  // A Supervisor-created, named group with an explicit member list (spec
  // §6-8) — unlike MARKET_GROUP (implicitly every employee in the
  // market, no membership rows needed), a CUSTOM_GROUP's members are
  // real ConversationMember rows, added/removed individually. `name` and
  // `createdById` on Conversation are only meaningful for this type.
  CUSTOM_GROUP
}

// FILE/AUDIO/VOICE only — an image attachment is still represented by
// Message.imageUrl (pre-existing, already wired end to end); this enum
// exists so the frontend can pick the right playback/preview UI for the
// other three kinds without sniffing a raw MIME string.
enum MessageAttachmentType {
  FILE
  AUDIO
  VOICE
}

// ---------------------------------------------------------------------
// Staff (Admin / Regional Manager / Supervisor / Overlooking Supervisor)
// — logs in with email (Admin/Regional Manager) or loginId (Supervisor/
// Overlooking — a case-insensitive "User ID", same concept as
// Employee.employeeCode/username, see authController.staffIdLogin).
// loginId is nullable/optional rather than replacing email entirely:
// Admin/Regional Manager accounts have no User ID in this spec and keep
// using email exclusively; every account still has a real email either
// way (required for account creation/notifications), loginId is just an
// additional login path some roles use instead.
// ---------------------------------------------------------------------
model User {
  id           Int       @id @default(autoincrement())
  name         String
  email        String    @unique
  loginId      String?   @unique
  passwordHash String
  role         StaffRole @default(SUPERVISOR)
  createdAt    DateTime  @default(now())

  // A Regional Manager can manage multiple zones (Zone.managerId has no
  // uniqueness constraint) — the RM management layer explicitly needs
  // this ("Regional Manager -> manages multiple Zones"); a single-zone RM
  // is just the common case of this same relation, not a different shape.
  managedZones  Zone[]   @relation("ZoneManager")
  // A Supervisor manages exactly one market.
  managedMarket Market?  @relation("MarketSupervisor")
  // An OVERLOOKING_SUPERVISOR manages exactly one market too — its own
  // distinct account/login, not the Supervisor's (see Market's comment).
  managedOverlookingMarket Market? @relation("MarketOverlookingSupervisor")

  // Tasks this staff member has reviewed (approved/rejected).
  reviewedTasks Task[] @relation("TaskReviewer")
  // Tasks this staff member proactively assigned to an employee.
  assignedTasks Task[] @relation("TaskAssigner")

  // Sudden Tasks this staff member has pushed to an employee.
  assignedSuddenTasks SuddenTask[] @relation("SuddenTaskAssigner")

  // Products this staff member added to a market's inventory.
  createdProducts Product[] @relation("ProductCreator")

  // Attendance rows this staff member imported directly (legacy single-row
  // path — the real Excel import now goes through AttendanceImportBatch).
  importedAttendance AttendanceRecord[] @relation("AttendanceImporter")

  requiredHoursAdjustments AttendanceAuditLog[]       @relation("AttendanceAuditor")
  adjustedRequiredHours    RequiredHoursAdjustment[]  @relation("RequiredHoursAdjuster")
  uploadedAttendanceImports AttendanceImportBatch[]   @relation("AttendanceImportUploader")
  reviewedLeaveRequests    LeaveRequest[]             @relation("LeaveReviewer")
  assignedDepartments      DepartmentAssignment[]     @relation("DepartmentAssigner")
  reviewedWastedOverallReports WastedOverallReport[]  @relation("WastedOverallReviewer")
  notifications                Notification[]         @relation("NotificationRecipientUser")

  sentMessages Message[] @relation("MessageSenderUser")
  supervisorConversations Conversation[] @relation("ConversationStaffParticipant")
  reviewedActivities Activity[] @relation("ActivityReviewer")
  messageReactions MessageReaction[] @relation("MessageReactionUser")

  marketVisits    MarketVisit[]    @relation("MarketVisitRM")
  marketRatings   MarketRating[]   @relation("MarketRatingRM")
  marketNotes     MarketNote[]     @relation("MarketNoteRM")
  marketFeedbacks MarketFeedback[] @relation("MarketFeedbackRM")
  createdGroups   Conversation[]   @relation("ConversationCreator")
  reviewedAttendanceAdjustments AttendanceAdjustmentRequest[] @relation("AttendanceAdjustmentReviewer")
  groupMemberships ConversationMember[] @relation("ConversationMemberUser")
  submittedTotalSalesReports TotalSalesReport[] @relation("TotalSalesSubmitter")
  submittedCardSalesReports  CardSalesReport[]  @relation("CardSalesSubmitter")
}

// ---------------------------------------------------------------------
// Zone -> Market -> Employee
// ---------------------------------------------------------------------
model Zone {
  id     Int  @id @default(autoincrement())
  number Int  @unique
  // No longer @unique — one Regional Manager can be assigned multiple
  // zones (see User.managedZones's own comment). A single-zone RM is
  // still the common case; nothing about that changes.
  managerId Int?
  manager   User?    @relation("ZoneManager", fields: [managerId], references: [id])
  markets   Market[]
  conversations Conversation[]
  createdAt DateTime @default(now())

  @@index([managerId])
}

model Market {
  id           String       @id @default(cuid())
  name         String
  status       MarketStatus @default(ACTIVE)
  zoneId       Int
  zone         Zone         @relation(fields: [zoneId], references: [id])
  supervisorId Int?         @unique
  supervisor   User?        @relation("MarketSupervisor", fields: [supervisorId], references: [id])
  // The market's Night/Evening-shift counterpart — a real, distinct
  // account (StaffRole.OVERLOOKING_SUPERVISOR), not a shift label chosen
  // at login. Nullable: a market may not have a dedicated Overlooking
  // account yet, same as supervisorId. Deliberately mirrors supervisorId
  // exactly (own @unique FK) rather than a generic "market staff" list,
  // since the two roles have genuinely different permissions (e.g. only
  // the Supervisor can submit Total Sales — see totalSalesController.js).
  overlookingSupervisorId Int?  @unique
  overlookingSupervisor   User? @relation("MarketOverlookingSupervisor", fields: [overlookingSupervisorId], references: [id])
  employees    Employee[]
  tasks        Task[]
  suddenTasks  SuddenTask[]
  products     Product[]
  itemReports  ItemReport[]
  priceReports PriceReport[]
  wastedOverallReports WastedOverallReport[]
  leaveRequests LeaveRequest[]
  attendanceImportBatches AttendanceImportBatch[]
  conversations Conversation[]
  createdAt    DateTime     @default(now())

  visits    MarketVisit[]
  ratings   MarketRating[]
  notes     MarketNote[]
  feedbacks MarketFeedback[]

  totalSalesReports TotalSalesReport[]
  cardSalesReports  CardSalesReport[]

  @@index([zoneId])
}

// Employees log in with an employeeCode + password, not an email — this
// matches the frontend's "find yourself" login flow for the Employee role.
//
// employeeCode/passwordHash are nullable to support a "pending" hire —
// an Employee row created before credentials are assigned (spec: "do
// not invent credentials, leave User ID and password unassigned until
// provided"). Login lookups naturally never match a NULL employeeCode
// (see authController.employeeLogin's own comment), and
// employeeLogin/cashierLogin explicitly reject a null passwordHash with
// a clear "not yet activated" error rather than attempting
// bcrypt.compare against it. A staff member assigns both together later
// via PATCH /api/employees/:id (see employeesController.updateEmployee).
model Employee {
  id            String       @id @default(cuid())
  employeeCode  String?      @unique
  name          String
  passwordHash  String?
  position      String
  secondaryRole String?
  shift         String?
  role          EmployeeRole @default(WORKER)
  marketId      String
  market        Market       @relation(fields: [marketId], references: [id])
  tasks         Task[]
  createdAt     DateTime     @default(now())

  // --- Employee Profile fields (Phase 1, Step 2) ---
  // All nullable/optional so existing employee rows don't break and none
  // of these are calculated yet — they're just places to store the data
  // once the matching feature (photo upload, real performance calc) exists.
  profilePictureUrl String?   // URL of an uploaded photo; no upload feature yet.
  startDate         DateTime? // The employee's real hire date (different from
                               // createdAt, which is just "when the DB row
                               // was created" and may not match reality).
  performanceRate   Int?      // Placeholder for a future calculated score.
                               // Nothing writes to this yet — see Step 7.

  // username/cashierShift stay Cashier-only (null for a WORKER) — separate
  // login identifier namespace, a Worker keeps logging in with employeeCode.
  username     String?       @unique
  cashierShift CashierShift? // drives whether Cleaning is shown

  // department applies to EVERY employee now (Worker or Cashier) — kept
  // as a fast denormalized "current department" cache, synced whenever a
  // new DepartmentAssignment is created; that table is the historical
  // source of truth (see DepartmentAssignment below).
  department       String?
  employmentStatus EmploymentStatus @default(ACTIVE)
  whatsappNumber   String?                   // tap-to-open wa.me link on the profile

  activities Activity[]
  suddenTasks SuddenTask[]
  itemReports ItemReport[]
  attendanceRecords         AttendanceRecord[]
  requiredHoursAdjustments  RequiredHoursAdjustment[]
  cashierCleaningLogs       CashierCleaningLog[]
  priceReports              PriceReport[]
  wastedOverallReports      WastedOverallReport[]
  leaveRequests             LeaveRequest[]
  departmentAssignments     DepartmentAssignment[]
  auditLogEntries           AttendanceAuditLog[]

  notifications         Notification[]
  sentMessages          Message[]          @relation("MessageSenderEmployee")
  conversationReads     ConversationRead[]
  directConversationsAsA Conversation[]    @relation("ConversationParticipantA")
  directConversationsAsB Conversation[]    @relation("ConversationParticipantB")
  messageReactions      MessageReaction[]  @relation("MessageReactionEmployee")
  groupMemberships      ConversationMember[]
  attendanceAdjustmentRequests AttendanceAdjustmentRequest[]

  @@index([marketId])
}

// ---------------------------------------------------------------------
// Task — the daily-activity submission / assignment / review workflow.
//
// NOTE: as of the Sudden Tasks module, this model has no frontend caller
// anywhere (no `taskService.js` exists) even though every endpoint below
// is implemented and tested. It was NOT reused for Sudden Tasks because
// `type` is an activity-shaped enum (FACING/REFILLING/...), not a
// freeform title+description+priority. Leaving this here unused rather
// than deleting it — it's a reasonable base for a future "Supervisor
// assigns a normal activity-shaped task" feature, but that's a decision
// for whoever builds the Supervisor module, not this change.
// ---------------------------------------------------------------------
model Task {
  id         String     @id @default(cuid())
  type       TaskType
  label      String
  department String
  notes      String?
  status     TaskStatus @default(PENDING)

  requiresPhoto  Boolean @default(false)
  // No file upload service is wired up yet — these hold a URL/path once
  // one exists. Left nullable so the API works before that's built.
  beforePhotoUrl String?
  afterPhotoUrl  String?

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  marketId   String
  market     Market   @relation(fields: [marketId], references: [id])

  // Set when a supervisor/manager proactively assigns this task instead
  // of the employee submitting it on their own initiative.
  assignedById Int?
  assignedBy   User?   @relation("TaskAssigner", fields: [assignedById], references: [id])

  reviewedById     Int?
  reviewedBy       User?     @relation("TaskReviewer", fields: [reviewedById], references: [id])
  rejectionReason  String?
  reviewedAt       DateTime?

  submittedAt DateTime  @default(now())
  createdAt   DateTime  @default(now())

  @@index([employeeId])
  @@index([marketId])
  @@index([status])
}

// ---------------------------------------------------------------------
// Activity — an employee's own daily activity log (Phase 1, Step 3/4).
// This is intentionally separate from Task: Task is "a supervisor gave
// me work to do", Activity is "I'm logging work I did on my own". Same
// review lifecycle shape (submit -> approve/reject) but a different
// reason for existing, so we do not merge them (Step 6).
model Activity {
  id       String           @id @default(cuid())
  category ActivityCategory
  date     DateTime
  time     String // e.g. "9:15 AM" — stored as text to mirror what the
                   // frontend already generates; no timezone-math is
                   // needed for a simple "what time did this happen" label.
  notes    String?
  status   ActivityStatus @default(DRAFT)

  // Set by a Supervisor's review (approve/reject) — mirrors Task's own
  // reviewedById/rejectionReason/reviewedAt shape exactly, since this is
  // the same "submit -> approve/reject" lifecycle, just for a
  // self-initiated Activity instead of a supervisor-assigned Task.
  reviewedById    Int?
  reviewedBy      User?     @relation("ActivityReviewer", fields: [reviewedById], references: [id])
  rejectionReason String?
  reviewedAt      DateTime?

  // Only meaningful for category = LABEL_CHECKING — the scanned/searched
  // Product the label issue was found on (same product-search flow as
  // ItemReport), and what's wrong with it. Null for every other category.
  productId      String?
  product        Product?        @relation(fields: [productId], references: [id])
  labelIssueType LabelIssueType?

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  images ActivityImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([status])
}

// One Activity can have many images, and each image belongs to exactly
// one Activity (Step 5) — instead of fixed photo1/photo2/photo3 columns
// on Activity, which would cap how many images an activity can ever have
// and waste columns whenever there are fewer. This scales to any number
// of images with no future schema change.
model ActivityImage {
  id  String @id @default(cuid())
  url String

  activityId String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([activityId])
}

// ---------------------------------------------------------------------
// SuddenTask — a Supervisor/Manager/Admin pushing an urgent task at an
// employee (see the SuddenTaskPriority/SuddenTaskStatus comment above for
// why this is its own model, separate from both Task and Activity).
// ---------------------------------------------------------------------
model SuddenTask {
  id          String             @id @default(cuid())
  title       String
  description String
  priority    SuddenTaskPriority @default(NORMAL)
  status      SuddenTaskStatus   @default(ASSIGNED)
  // Set by completeSuddenTask when the supervisor requires photo evidence
  // — previously completion was a bare status flip with nowhere to put
  // the photo the spec explicitly asks for.
  evidenceUrl String?

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  marketId   String
  market     Market   @relation(fields: [marketId], references: [id])

  assignedById Int
  assignedBy   User   @relation("SuddenTaskAssigner", fields: [assignedById], references: [id])

  assignedAt  DateTime  @default(now())
  completedAt DateTime?

  @@index([employeeId])
  @@index([marketId])
  @@index([status])
}

// ---------------------------------------------------------------------
// Product — a minimal per-market inventory catalog, just enough to back
// the Expired/Wasted Items report-and-decrement flow. No real
// Inventory/Indent Management system exists to integrate with, so this
// is the system of record for stock quantity until one does.
// ---------------------------------------------------------------------
model Product {
  id            String   @id @default(cuid())
  barcode       String
  name          String
  stockQuantity Int      @default(0)
  // The product's real selling price — nullable, since not every product
  // in this catalog has had one entered yet (see productsController.js).
  // Powers the Cashier Price Lookup flow: a product with no price set
  // shows "Price not set" honestly rather than a fabricated number.
  price         Float?

  marketId String
  market   Market @relation(fields: [marketId], references: [id])

  createdById Int
  createdBy   User @relation("ProductCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  itemReports ItemReport[]
  labelActivities Activity[]

  // Same barcode can be separate stock in different markets, so the
  // uniqueness is per-market, not global.
  @@unique([barcode, marketId])
  @@index([marketId])
}

// ItemReport — an employee reporting a Product as expired or wasted.
// Submitting one immediately decrements Product.stockQuantity in the
// same transaction (see itemReportsController.js) — no manual inventory
// adjustment from a supervisor required, per the spec. `status` exists
// for audit/review purposes only; it does not gate the stock decrement.
model ItemReport {
  id          String         @id @default(cuid())
  condition   ItemCondition
  quantity    Int
  status      ActivityStatus @default(PENDING)
  notes       String?
  imageUrl    String?

  productId String
  product   Product @relation(fields: [productId], references: [id])

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  marketId   String
  market     Market   @relation(fields: [marketId], references: [id])

  reportedAt DateTime @default(now())

  @@index([employeeId])
  @@index([productId])
  @@index([marketId])
  @@index([reportedAt])
}

// ---------------------------------------------------------------------
// AttendanceRecord — one employee's attendance for one day: status,
// shift, check-in/out, break times, and required hours for that day.
// Populated by importAttendanceRecords (a staff-side Excel import — see
// attendanceController.js) rather than a live fingerprint-device feed,
// which isn't reachable from this app. Working hours are computed from
// checkIn/checkOut/break, not stored, so there's no redundant derived
// value to drift out of sync — requiredHours IS stored (not computed)
// because it's a real, independently-set value (default 8, overridable
// per day by a RequiredHoursAdjustment), not derived from anything else.
// ---------------------------------------------------------------------
model AttendanceRecord {
  id            String           @id @default(cuid())
  date          DateTime // the day this record is for; time part is ignored
  status        AttendanceStatus @default(PRESENT)
  shift         Shift?
  checkIn       DateTime?
  checkOut      DateTime?
  breakStart    DateTime?
  breakEnd      DateTime?
  dayOffType    DayOffType? // only meaningful when status = DAY_OFF
  requiredHours Int              @default(8) // 4-16, enforced in validate.js
  // Explicit penalty hours for this day, set only by staff (see
  // attendanceController.setPunishmentHours) — unlike extra hours (always
  // derived as max(workingHours - requiredHours, 0), never stored, same
  // as workingHours itself), a penalty has no computable source of truth
  // and must be recorded directly.
  punishmentHours Float          @default(0)
  // Why the penalty was applied — was previously only written to
  // AttendanceAuditLog (audit-only, never fetched by the employee-facing
  // endpoint), so the employee had no way to see it even though the
  // supervisor entered one. Stored directly on the record now, exactly
  // like RequiredHoursAdjustment.reason for extra/reward hours, so both
  // behave the same way to the employee.
  punishmentReason String?
  source        AttendanceSource @default(MANUAL)
  // The original imported row, preserved verbatim for audit purposes
  // (spec: "Preserve the original imported data") — only set when
  // source = IMPORT.
  rawImportData Json?

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  importedById Int?
  importedBy   User? @relation("AttendanceImporter", fields: [importedById], references: [id])

  importBatchId String?
  importBatch   AttendanceImportBatch? @relation(fields: [importBatchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One record per employee per day — makes re-importing the same export
  // file idempotent (upsert on this constraint) instead of duplicating rows.
  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([date])
}

// RequiredHoursAdjustment — a supervisor's override of an employee's
// required hours for one specific date (e.g. "8 -> 7, reward for
// exceptional performance"). Kept as its own append-only history table
// (never edited/deleted) so the full previous/new/reason/who/when trail
// survives even though AttendanceRecord.requiredHours itself is mutable
// (always reflects the CURRENT value). Replaces the earlier
// REWARD/EXTRA/PENALTY hour-delta model — that shape never matched what
// this spec actually needs (a direct override, not a delta), and nothing
// depended on the old shape (no Supervisor UI ever created one).
model RequiredHoursAdjustment {
  id                    String   @id @default(cuid())
  date                  DateTime // the day this adjustment applies to
  previousRequiredHours Int
  newRequiredHours      Int // 4-16, enforced in validate.js
  reason                String

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  adjustedById Int
  adjustedBy   User @relation("RequiredHoursAdjuster", fields: [adjustedById], references: [id])

  createdAt DateTime @default(now())

  @@index([employeeId])
  @@index([date])
}

// AttendanceImportBatch — one row per Excel attendance import, tracking
// who/when/how-many so every import is auditable and repeat-safe (spec
// §5/§16). AttendanceRecord.importBatchId links every record the batch
// touched back to it.
model AttendanceImportBatch {
  id             String   @id @default(cuid())
  fileName       String?
  periodStart    DateTime
  periodEnd      DateTime
  totalRecords   Int
  createdCount   Int
  updatedCount   Int
  unmatchedCount Int
  rejectedCount  Int
  errors         Json // [{ row, employeeCode?, message }]
  importedAt     DateTime @default(now())

  marketId String
  market   Market @relation(fields: [marketId], references: [id])

  uploadedById Int
  uploadedBy   User @relation("AttendanceImportUploader", fields: [uploadedById], references: [id])

  records AttendanceRecord[]

  @@index([marketId])
}

// LeaveRequest — an employee requesting a Monthly Off day or Personal
// Leave for a specific date, reviewed by their Supervisor. Approving one
// upserts the matching AttendanceRecord (DAY_OFF or APPROVED_LEAVE) in
// the same transaction, so the calendar never shows a conflicting
// "Present" day for an approved leave (spec §11).
model LeaveRequest {
  id          String              @id @default(cuid())
  date        DateTime
  type        LeaveRequestType
  reason      String? // required for PERSONAL_LEAVE, enforced in validate.js
  // Only set (and only meaningful) for type = EARNED_DAY_OFF — how many
  // extra-hours-balance hours this request spends. Re-validated against
  // the employee's current balance at both create and approve time (see
  // leaveRequestsController) — approve time is authoritative since the
  // balance can change between request and review.
  hoursSpent  Int?
  status      LeaveRequestStatus  @default(PENDING)
  submittedAt DateTime            @default(now())

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  marketId   String // denormalized for the Supervisor review-queue query
  market     Market  @relation(fields: [marketId], references: [id])

  reviewedById Int?
  reviewedBy   User?     @relation("LeaveReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  reviewNote   String?

  // One request per employee per date — a second submission for the same
  // day is a clean 409 (existing errorHandler.js P2002 handling), not a
  // duplicate row.
  @@unique([employeeId, date])
  @@index([marketId])
  @@index([status])
}

// AttendanceAuditLog — generic audit trail for attendance-adjacent
// mutations (required-hours adjustments, leave approve/reject, imports,
// future manual corrections). One row per action, append-only. Spec §13
// asks for exactly this: who, what changed, previous value, new value,
// reason, when.
model AttendanceAuditLog {
  id     String @id @default(cuid())
  action String // "REQUIRED_HOURS_ADJUSTED" | "LEAVE_APPROVED" | "LEAVE_REJECTED" | "ATTENDANCE_IMPORTED" | ...

  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id])

  performedById Int
  performedBy   User @relation("AttendanceAuditor", fields: [performedById], references: [id])

  previousValue Json?
  newValue      Json?
  reason        String?

  createdAt DateTime @default(now())

  @@index([employeeId])
  @@index([createdAt])
}

// DepartmentAssignment — history of which department an employee belonged
// to and when (spec §3: "store department assignment history"). Applies
// to every employee (Worker or Cashier). Employee.department is kept as
// a fast denormalized cache of whichever assignment has endDate = null
// (the current one); this table is the source of truth for "what
// department were they in on date X".
model DepartmentAssignment {
  id         String    @id @default(cuid())
  department String
  startDate  DateTime  @default(now())
  endDate    DateTime? // set when the NEXT assignment starts; null = current

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  assignedById Int
  assignedBy   User @relation("DepartmentAssigner", fields: [assignedById], references: [id])

  @@index([employeeId])
}

// ---------------------------------------------------------------------
// CashierCleaningLog — one row per cashier per day, station-cleaning
// checklist. Deliberately NOT the same thing as Activity's SHELF_CLEANING
// category: this always means "clean the cashier station", never shelf/
// aisle/department cleaning, and only Morning-shift cashiers see this
// page at all (see cashierCleaningController.js). `items` is a JSON
// snapshot of the fixed checklist (label + checked) rather than a child
// table — the checklist is a small, fixed set of labels defined on the
// frontend, not independently queryable/reportable data.
// ---------------------------------------------------------------------
model CashierCleaningLog {
  id          String    @id @default(cuid())
  date        DateTime // the day this applies to; time part ignored
  items       Json // [{ label: string, checked: boolean }]
  completedAt DateTime?

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One log per cashier per day — same idempotent-upsert idiom as
  // AttendanceRecord.
  @@unique([employeeId, date])
  @@index([employeeId])
}

// ---------------------------------------------------------------------
// PriceReport — a cashier flagging a shelf-price vs. POS-system-price
// mismatch. Its own model, not ItemReport: no product/inventory link or
// stock side-effect, just two prices, an optional photo, and a route to
// the Supervisor for review (see priceReportsController.js — "send to
// the Supervisor" means the report is immediately visible to any
// Supervisor of this market, since no push-notification system exists
// anywhere in this app).
// ---------------------------------------------------------------------
model PriceReport {
  id          String         @id @default(cuid())
  productName String
  barcode     String?
  shelfPrice  Float
  systemPrice Float
  notes       String?
  photoUrl    String?
  shift       CashierShift? // the cashier's shift at the time of reporting
  status      ActivityStatus @default(PENDING)

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  marketId   String
  market     Market   @relation(fields: [marketId], references: [id])

  reportedAt DateTime @default(now())

  @@index([employeeId])
  @@index([marketId])
  @@index([reportedAt])
}

// The five produce items this feature supports — a fixed enum, not a
// Product catalog reference. Deliberately NOT reusing ItemReport: that
// model has a required, non-nullable productId hard-FK'd to a real
// market-scoped Product row and unconditionally decrements its
// stockQuantity in the same transaction — neither of those is meaningful
// for a fixed produce list with no catalog entry. This model mirrors
// PriceReport's shape instead (no product/inventory link, just fields +
// an optional photo + a route to the Supervisor for review) for the same
// reason PriceReport itself isn't ItemReport.
enum WastedItem {
  EGGS
  TOMATO
  POTATO
  CUCUMBER
  ONION
  // A produce item not on the fixed list — see otherItemName below for
  // the required free-text identifying it.
  OTHER
}

// ---------------------------------------------------------------------
// WastedOverallReport — a Worker reporting wasted produce (one of the
// WastedItem values) with a photo and a quantity. Routed automatically
// to the Supervisor of the reporting employee's market
// (Employee.marketId -> Market.supervisorId), who is notified via the
// existing Notification system (type WASTED_OVERALL) — the worker never
// picks a Supervisor themselves.
//
// Quantity unit varies by item: EGGS is counted in whole pieces
// (quantityCount), every other item (including OTHER) is weighed in kg
// (quantityKg) — exactly one of the two is set, enforced in validate.js.
// Both fields are nullable rather than one being repurposed, so existing
// rows (all kg-based, including pre-existing EGGS rows reported in kg
// before this change) are never reinterpreted: an old EGGS row keeps its
// original quantityKg value untouched, quantityCount stays null on it.
// ---------------------------------------------------------------------
model WastedOverallReport {
  id            String         @id @default(cuid())
  item          WastedItem
  quantityKg    Float? // > 0 when set, enforced in validate.js
  quantityCount Int? // > 0 when set (pieces, EGGS only going forward), enforced in validate.js
  // Required identifying text when item = OTHER (what the worker actually
  // wasted, since "Other" alone isn't useful) — null for every other item.
  otherItemName String?
  photoUrl      String?
  notes         String?
  status        ActivityStatus @default(PENDING)
  // Set on a Supervisor's REJECTED review — mirrors Activity/Task's own
  // rejectionReason shape.
  rejectionReason String?

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  marketId   String
  market     Market   @relation(fields: [marketId], references: [id])

  reviewedById Int?
  reviewedBy   User?     @relation("WastedOverallReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?

  reportedAt DateTime @default(now())

  @@index([employeeId])
  @@index([marketId])
  @@index([reportedAt])
}

// ---------------------------------------------------------------------
// Notification — a real feed, replacing what used to be just a
// TODO comment ("this toast is NOT a real notification system") in
// EmployeeWorkspace.jsx. See the NotificationType comment above for
// which concrete actions write one.
// ---------------------------------------------------------------------
// Recipient is EITHER an Employee OR a staff User, never both — same
// dual-nullable-FK pattern already used by Message's
// senderEmployeeId/senderUserId (enforced in the controller, not the DB,
// per that model's own comment on why). Added for WASTED_OVERALL: a
// Worker's report notifies their market's Supervisor, who is staff, not
// an Employee — every notification before this one only ever had an
// Employee recipient, so this couldn't be represented before.
model Notification {
  id    String           @id @default(cuid())
  type  NotificationType
  title String
  body  String
  read  Boolean          @default(false)

  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id])
  userId     Int?
  user       User?     @relation("NotificationRecipientUser", fields: [userId], references: [id])

  // Lets the frontend route to the right screen on tap without parsing
  // `body` — e.g. linkType "SUDDEN_TASK" + linkId = that task's id.
  linkType String?
  linkId   String?

  createdAt DateTime @default(now())

  @@index([employeeId, read])
  @@index([userId, read])
}

// ---------------------------------------------------------------------
// Conversation — one per Market Group, one per Warnings channel, and one
// per Direct pair of employees. Group/Warnings are found-or-created in
// chatController.js (see the ConversationType comment above for why that
// can't be a bare DB constraint); Direct relies on the unique index below
// with participantAId/participantBId always stored in a consistent order
// (enforced in the controller) so the same pair never gets two rows.
// ---------------------------------------------------------------------
model Conversation {
  id   String           @id @default(cuid())
  type ConversationType

  // CUSTOM_GROUP only: the group's display name/photo (spec §6/§8/RM §1 —
  // renamable, persists for every member) and the staff account that
  // created it. The creator is automatically a group admin (see
  // ConversationMember.isAdmin) — but group-management authorization is
  // never "am I the creator", always "do I have an admin membership row",
  // so a promoted-then-un-promoted creator loses control exactly like
  // anyone else (see chatController.js's requireGroupAdmin).
  name        String?
  pictureUrl  String?
  createdById Int?
  createdBy   User?   @relation("ConversationCreator", fields: [createdById], references: [id])

  // Every non-CUSTOM_GROUP type is always scoped to exactly one market
  // (required). A CUSTOM_GROUP may instead be scoped to a whole zone
  // (marketId null, zoneId set — spec's "Regional/Zone Groups", e.g. a
  // Regional Manager's cross-market "Supervisors Group") or to one single
  // market (marketId set, same as before). Authorization for a
  // zone-scoped group is checked against zoneId instead of marketId (see
  // assertZoneAccess) — actual access, either way, is ultimately decided
  // by explicit ConversationMember rows, never implicit market/zone
  // membership (unlike MARKET_GROUP/WARNINGS, which stay implicit).
  marketId String?
  market   Market? @relation(fields: [marketId], references: [id])
  zoneId   Int?
  zone     Zone?   @relation(fields: [zoneId], references: [id])

  participantAId String? // DIRECT: one of the two Employees. SUPERVISOR_DIRECT: the Employee.
  participantA   Employee? @relation("ConversationParticipantA", fields: [participantAId], references: [id])
  participantBId String? // DIRECT only: the other Employee.
  participantB   Employee? @relation("ConversationParticipantB", fields: [participantBId], references: [id])
  // SUPERVISOR_DIRECT only: the Supervisor's User id (fixed at creation
  // to Market.supervisorId) — nullable and distinct from participantB
  // rather than repurposing it, since a DIRECT participant is always an
  // Employee and a SUPERVISOR_DIRECT one is always staff.
  staffParticipantId Int?
  staffParticipant   User? @relation("ConversationStaffParticipant", fields: [staffParticipantId], references: [id])

  // RM_DIRECT only: true until the Regional Manager sends the first
  // message, after which it flips to false and stays false (the spec's
  // own rule — "once unlocked, remains available"). Enforced in
  // chatController.sendMessage, not just hidden in the UI. Meaningless
  // for every other ConversationType (defaults true but nothing reads it
  // for them).
  locked Boolean @default(true)

  createdAt DateTime @default(now())

  messages Message[]
  reads    ConversationRead[]
  members  ConversationMember[]

  @@unique([marketId, type, participantAId, participantBId, staffParticipantId])
  @@index([marketId])
}

// ConversationMember — explicit membership for a CUSTOM_GROUP (spec
// §6/§7: add/remove members, view current members). Every other
// ConversationType determines "who's in it" a different way (implicit
// market-wide for MARKET_GROUP/WARNINGS, the two participant columns for
// DIRECT/SUPERVISOR_DIRECT/RM_DIRECT) — this table is only ever
// populated for CUSTOM_GROUP.
//
// A member is EITHER an Employee OR a staff User, never both (same
// dual-nullable-FK pattern as Message.sender — enforced in the
// controller, not the DB). Staff membership is what makes a Regional
// Manager's cross-market "Supervisors Group" possible: its members are
// User rows (each market's Supervisor/Overlooking account), not
// Employees at all.
//
// isAdmin — spec's own explicit rule: "do not make every Supervisor
// automatically the administrator of every group." A member controls the
// group (add/remove/promote/rename/change picture) only if THEIR OWN
// membership row has isAdmin=true — set true automatically for the
// creator's row at creation, and toggleable afterward by any other admin
// (see chatController.promoteGroupAdmin/demoteGroupAdmin). Being
// SUPERVISOR/REGIONAL_MANAGER by role is never sufficient on its own.
model ConversationMember {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  employeeId     String?
  employee       Employee?    @relation(fields: [employeeId], references: [id])
  userId         Int?
  user           User?        @relation("ConversationMemberUser", fields: [userId], references: [id])
  isAdmin        Boolean      @default(false)
  addedAt        DateTime     @default(now())

  @@unique([conversationId, employeeId])
  @@unique([conversationId, userId])
  @@index([conversationId])
}

// Message — sender is EITHER an Employee OR a staff User (Warnings
// broadcasts come from staff), never both; enforced in chatController.js,
// not at the DB layer, since Prisma has no native "exactly one of two
// nullable FKs" constraint.
model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  body     String // may be "" for an attachment-only message (image/file/audio/voice with no caption)
  imageUrl String? // existing image-attachment path, left as-is — see attachmentType for file/audio/voice

  // Generic attachment path added for file/audio/voice — image sending
  // already worked via imageUrl before this, so that field/UI is left
  // untouched rather than folded into this generic shape too.
  attachmentType        MessageAttachmentType?
  attachmentUrl         String?
  attachmentName        String? // original filename, for FILE
  attachmentSize        Int? // bytes
  attachmentDurationSec Int? // AUDIO / VOICE playback duration

  senderEmployeeId String?
  senderEmployee   Employee? @relation("MessageSenderEmployee", fields: [senderEmployeeId], references: [id])
  senderUserId     Int?
  senderUser       User?     @relation("MessageSenderUser", fields: [senderUserId], references: [id])

  // Self-relation for "reply to a specific message" — nullable, one level
  // (a reply to a reply still just points at that message directly, no
  // reply chain/thread tree; matches the spec's own "reply preview", not
  // full threading).
  replyToId String?
  replyTo   Message?  @relation("MessageReplyTo", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   Message[] @relation("MessageReplyTo")

  // Set when this message was created via Forward (spec §5) — a snapshot
  // of the ORIGINAL sender's name at forward time, not a live FK to the
  // source message/conversation. Deliberately a denormalized label, not
  // a relation: the forwarder and the recipient(s) of the forward may
  // not share access to the original conversation, so this never exposes
  // more than "who first sent this", and it stays stable even if the
  // original message is later edited or deleted. Never set together with
  // replyToId (forwarding and replying are different actions).
  forwardedFromSenderName String?

  // Set when the sender edits their own text message; the frontend shows
  // "Edited" whenever this is non-null rather than storing edit history.
  editedAt DateTime?
  // Soft-delete: body/attachments are blanked out by the controller when
  // this is set, but the row itself is kept (spec: "preserve appropriate
  // auditability for workplace communication") rather than hard-deleted.
  deletedAt DateTime?

  reactions MessageReaction[]

  createdAt DateTime @default(now())

  @@index([conversationId, createdAt])
  @@index([replyToId])
}

// MessageReaction — one reaction per person per message; reacting again
// with the same emoji removes it, a different emoji replaces it (see
// chatController.reactToMessage). Sender is EITHER an Employee OR a
// staff User, same dual-nullable-FK pattern as Message.sender — enforced
// in the controller, and the two separate @@unique constraints below
// only ever bind on whichever side is non-null for a given row (a NULL
// employeeId never collides with another NULL employeeId in Postgres).
model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  emoji     String

  employeeId String?
  employee   Employee? @relation("MessageReactionEmployee", fields: [employeeId], references: [id])
  userId     Int?
  user       User?     @relation("MessageReactionUser", fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@unique([messageId, employeeId])
  @@unique([messageId, userId])
  @@index([messageId])
}

// ConversationRead — one row per (conversation, employee), tracking read
// position, and now also that employee's pin/mute preference for this
// conversation (their own "relationship to this conversation" row is the
// natural place for both, rather than a third table). Unread count =
// messages in that conversation created after lastReadAt (or every
// message, if no row exists yet — never opened). Employee-only for now
// (same limitation as the rest of this model) — a Supervisor pinning/
// muting their own conversations isn't implemented in this pass.
model ConversationRead {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  employeeId     String
  employee       Employee     @relation(fields: [employeeId], references: [id])
  lastReadAt     DateTime     @default(now())
  pinned         Boolean      @default(false)
  muted          Boolean      @default(false)

  @@unique([conversationId, employeeId])
}

// ---------------------------------------------------------------------
// Regional Manager market management — a Regional Manager's inspection
// record for one of their markets: a rating (1-10, historized, never
// overwritten), a management note, or formal feedback (a Warning or
// Recognition sent to the market's Supervisor). All three are distinct
// from Chat (see the spec: "Warning != Chat" — a Warning/Recognition is a
// formal management record, not a message bubble) and from each other,
// but can optionally belong to one MarketVisit so a single inspection's
// rating/notes/feedback show up together as one visit record instead of
// unrelated rows (spec §25).
// ---------------------------------------------------------------------
model MarketVisit {
  id                String   @id @default(cuid())
  marketId          String
  market            Market   @relation(fields: [marketId], references: [id])
  regionalManagerId Int
  regionalManager   User     @relation("MarketVisitRM", fields: [regionalManagerId], references: [id])
  visitDate         DateTime @default(now())
  createdAt         DateTime @default(now())

  ratings   MarketRating[]
  notes     MarketNote[]
  feedbacks MarketFeedback[]

  @@index([marketId])
  @@index([regionalManagerId])
}

// A rating is never edited/overwritten — each one is its own row, so
// "current rating" (most recent) and "rating history/trend" both come
// from the same table with no separate audit log needed.
model MarketRating {
  id                String       @id @default(cuid())
  marketId          String
  market            Market       @relation(fields: [marketId], references: [id])
  regionalManagerId Int
  regionalManager   User         @relation("MarketRatingRM", fields: [regionalManagerId], references: [id])
  rating            Int // 1-10, enforced in validate.js
  notes             String?
  visitId           String?
  visit             MarketVisit? @relation(fields: [visitId], references: [id])
  createdAt         DateTime     @default(now())

  @@index([marketId, createdAt])
}

model MarketNote {
  id                String       @id @default(cuid())
  marketId          String
  market            Market       @relation(fields: [marketId], references: [id])
  regionalManagerId Int
  regionalManager   User         @relation("MarketNoteRM", fields: [regionalManagerId], references: [id])
  content           String
  category          String?
  visitId           String?
  visit             MarketVisit? @relation(fields: [visitId], references: [id])
  createdAt         DateTime     @default(now())

  @@index([marketId, createdAt])
}

enum MarketFeedbackType {
  WARNING
  RECOGNITION
}

enum MarketFeedbackPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

// A formal Warning or Recognition, always routed to the market's
// Supervisor (never the whole market's employees — same "the Supervisor
// is the single point of contact" convention already used by Wasted
// Overall reports). Delivered as a real staff Notification, not a Chat
// message (spec §21 — kept structurally separate from Message/
// Conversation entirely, not just styled differently).
model MarketFeedback {
  id                String                  @id @default(cuid())
  marketId          String
  market            Market                  @relation(fields: [marketId], references: [id])
  regionalManagerId Int
  regionalManager   User                    @relation("MarketFeedbackRM", fields: [regionalManagerId], references: [id])
  type              MarketFeedbackType
  title             String
  description       String
  category          String?
  priority          MarketFeedbackPriority  @default(NORMAL)
  photoUrl          String?
  visitId           String?
  visit             MarketVisit?            @relation(fields: [visitId], references: [id])
  createdAt         DateTime                @default(now())

  @@index([marketId, createdAt])
}

// ---------------------------------------------------------------------
// AttendanceAdjustmentRequest — an employee-submitted claim of extra
// hours worked, pending Supervisor review (spec §10-14). Deliberately
// its own model, not a repurposing of RequiredHoursAdjustment (that one
// is a staff-authoritative override, written instantly, no pending
// state) or AttendanceRecord.punishmentHours (staff-only, instant) —
// this is the opposite direction: the EMPLOYEE claims something, and it
// only becomes real once a Supervisor approves it. `type` is scoped to
// EXTRA_WORK today (the only thing an employee can submit per spec §10);
// the enum leaves room for a future staff-facing use without implying
// one exists yet. Deliberately NOT folded into the existing derived
// "extra hours" calculation (computeExtraHours in
// attendanceController.js) or the extra-hours-balance used for Earned
// Day Off — spec §15 explicitly keeps this independent of any
// hours-driven calculation until a final model is agreed; today this is
// purely a reviewable record, visible in Attendance History.
// ---------------------------------------------------------------------
enum AttendanceAdjustmentType {
  EXTRA_WORK
}

enum AttendanceAdjustmentStatus {
  PENDING
  APPROVED
  REJECTED
}

model AttendanceAdjustmentRequest {
  id         String                   @id @default(cuid())
  employeeId String
  employee   Employee                 @relation(fields: [employeeId], references: [id])
  date       DateTime // the day the extra hours were worked; time part ignored
  type       AttendanceAdjustmentType @default(EXTRA_WORK)
  hours      Float // > 0, enforced in validate.js
  reason     String?
  status     AttendanceAdjustmentStatus @default(PENDING)

  reviewedById Int?
  reviewedBy   User?     @relation("AttendanceAdjustmentReviewer", fields: [reviewedById], references: [id])
  reviewNote   String?
  reviewedAt   DateTime?

  createdAt DateTime @default(now())

  @@index([employeeId])
  @@index([status])
}

// ---------------------------------------------------------------------
// Total Sales — a market's total money sold in one 24-hour reporting day
// (RM/Supervisor spec §4-5). Supervisor-only to submit; Regional
// Manager-only to view (Admin can too, via the same staff-role gate every
// other market-scoped endpoint uses) — never exposed to employees or to
// the market's own Overlooking account. Deliberately append-only, never
// upserted: "preserve historical records rather than simply replacing
// previous reports" (spec's own words) — a market/day can accumulate more
// than one row (e.g. a corrected resubmission); the controller's
// day-view picks the most recent, but nothing is ever deleted/overwritten.
model TotalSalesReport {
  id       String @id @default(cuid())
  marketId String
  market   Market @relation(fields: [marketId], references: [id])

  date   DateTime // the 24-hour reporting day this covers; time part ignored
  amount Float // > 0, enforced in validate.js — never a fabricated/rounded estimate
  photoUrl String // evidence photo of the sales report, required

  submittedById Int
  submittedBy   User     @relation("TotalSalesSubmitter", fields: [submittedById], references: [id])
  submittedAt   DateTime @default(now())

  @@index([marketId, date])
}

// ---------------------------------------------------------------------
// Card Sales — a per-shift card-count verification, separate from Total
// Sales (spec §6-8): three reporting periods per day (Morning/Afternoon/
// Night — labels only, not enforced clock times, per spec's own "should
// not be treated as rigid hardcoded times"), 1-2 evidence photos,
// submittable by either the market's Supervisor OR its Overlooking
// account. No unique constraint on (marketId, date, shift) for the same
// append-only-history reason as TotalSalesReport — a shift can be
// resubmitted/corrected; the controller's day-view always shows the most
// recent row per shift.
model CardSalesReport {
  id       String @id @default(cuid())
  marketId String
  market   Market @relation(fields: [marketId], references: [id])

  date  DateTime // the reporting day this shift belongs to; time part ignored
  shift CardSalesShift

  photoUrl  String // at least one evidence photo is required
  photoUrl2 String? // an optional second photo (spec: "up to two photos")

  submittedById Int
  submittedBy   User     @relation("CardSalesSubmitter", fields: [submittedById], references: [id])
  submittedAt   DateTime @default(now())

  @@index([marketId, date])
}

enum CardSalesShift {
  MORNING
  AFTERNOON
  NIGHT
}
