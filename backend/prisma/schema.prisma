// Prisma schema for TEAMMART.
//
// This is an evolution of the original schema. It keeps the same core
// idea (Zone -> Market -> Employee) but adds what the new frontend
// (teammart_draft_1) actually needs:
//   - Three real login types: staff (Admin / Regional Manager / Supervisor)
//     and Employees (who log in with an employee code, not an email).
//   - A Market now has its own Supervisor (not just a Zone manager).
//   - A Task model for the daily-activity submission/approval workflow.
//
// Naming note: the OLD schema called the top staff role
// "REGIONAL_SUPERVISOR" and had a "ZONE_MANAGER". The frontend actually
// has three different people: Admin, Regional Manager (zone-scoped), and
// Supervisor (market-scoped). We renamed the enum to match the frontend
// exactly, so there is one shared vocabulary across the whole stack.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------

// Staff roles. Employees are NOT part of this enum — they are a separate
// model with their own login, because in the frontend they are a
// fundamentally different kind of account (scoped to just themselves).
enum StaffRole {
  ADMIN
  REGIONAL_MANAGER
  SUPERVISOR
  // A market's Night/Evening shift counterpart to its SUPERVISOR — its
  // own real account (Market.overlookingSupervisorId), not a shift label
  // on the Supervisor login (see Market's own comment). Has a narrower
  // permission set than SUPERVISOR: e.g. can submit Card Sales but not
  // Total Sales (see totalSalesController.js / cardSalesController.js).
  OVERLOOKING_SUPERVISOR
}

enum MarketStatus {
  ACTIVE
  MAINTENANCE
  CLOSED
}

// Mirrors the frontend's TASK_SUBMISSION_OPTIONS / ACTIVITY_TYPES.
enum TaskType {
  FACING
  REFILLING
  DEPARTMENT_PHOTO
  WASTE_ITEMS
  SHELF_CLEANING
  CHECKING_LABELS
  COUNTING_ITEMS
  CUSTOMIZATION
}

// ASSIGNED      -> a supervisor/manager created this task for an employee, not started yet
// PENDING       -> employee submitted work, waiting for a supervisor to review it
// APPROVED      -> reviewed and accepted
// REJECTED      -> reviewed and sent back (see rejectionReason)
enum TaskStatus {
  ASSIGNED
  PENDING
  APPROVED
  REJECTED
}

// ---------------------------------------------------------------------
// Activity — Phase 1, Step 3. Categories an employee's own daily activity
// log can belong to. One reusable model + this enum stands in for what
// would otherwise be six near-identical tables (ShelfCleaning,
// LabelChecking, Inventory, DailyCleaning, ...). Adding a new category
// later is a one-line enum change instead of a new table + migration +
// new controller.
enum ActivityCategory {
  EXPIRED_ITEMS
  SHELF_CLEANING
  PRODUCT_CUSTOMIZATION
  DAILY_CLEANING
  ITEM_COUNTING
  LABEL_CHECKING
  FACING
  REFILLING
  // "How did you leave your department?" (Phase 1 foundation) — a
  // distinct concept from FACING (a specific shelf-facing task): this is
  // an end-of-shift department-condition submission, with its own
  // department/expiring-photo/optional-supervisor-submitted fields below
  // on Activity itself. Reuses this same model rather than a parallel
  // one — see Activity's own comment.
  DEPARTMENT_CLOSING
  // Night Shift — ONE category for every configurable, admin-defined
  // Night Shift task (Washing Market today, Freezer Check/Closing
  // Inspection/etc. later), rather than a new enum value per task —
  // Activity.nightShiftTaskDefinitionId below says WHICH task; this
  // mirrors this exact enum's own doc comment ("adding a new category
  // is a one-line enum change instead of a new table") one level
  // further: a new Night Shift task type needs a new
  // NightShiftTaskDefinition *row*, not even a schema change.
  NIGHT_SHIFT_TASK
}

// Only meaningful when Activity.category = LABEL_CHECKING — what's wrong
// with the label the employee found (spec: Missing/Incorrect/Damaged).
enum LabelIssueType {
  MISSING
  INCORRECT
  DAMAGED
}

// Deliberately only these four values (Step 4 spec). Note this is a
// SEPARATE enum from TaskStatus even though they share three names —
// Activity has no "ASSIGNED" state because an employee logs their own
// activity, nobody assigns it to them (that concept stays on Task).
// DRAFT   -> employee started an entry but hasn't submitted it yet
// PENDING -> submitted, waiting for a supervisor to review it (later)
// APPROVED / REJECTED -> reviewed (review endpoints are NOT built yet —
// this module only lets an employee reach DRAFT/PENDING themselves)
enum ActivityStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

// ---------------------------------------------------------------------
// SuddenTask — a Supervisor/Manager/Admin pushing an urgent, ASAP task to
// an employee. Deliberately its own model, not a reuse of Task: Task's
// `type` field is an enum of activity-shaped categories (FACING,
// REFILLING, ...) meant for the daily-activity submission flow, whereas a
// Sudden Task is a freeform title/description with a priority — a
// different shape for a different purpose. Also deliberately not merged
// into Activity, which is "an employee logging their own work", not
// "a supervisor pushing urgent work at an employee".
enum SuddenTaskPriority {
  NORMAL
  HIGH
  URGENT
}

// ASSIGNED  -> pushed to the employee, not done yet
// COMPLETED -> employee marked it done
enum SuddenTaskStatus {
  ASSIGNED
  COMPLETED
}

// ---------------------------------------------------------------------
// Expired & Wasted Items — an employee identifies a Product (barcode scan
// or photo -> manual product search, see itemReportsController.js for
// why there's no real AI photo recognition here) and reports it as no
// longer sellable. Deliberately its own model, not folded into Activity:
// this has a Product link + quantity + an automatic stock side-effect
// that no other Activity category needs.
// ---------------------------------------------------------------------
enum ItemCondition {
  EXPIRED
  WASTED
}

// ---------------------------------------------------------------------
// Attendance — worked hours are NOT a Task or Activity; they're a
// separate concern entirely. Check-in/out, breaks, shift, day-off, and
// reward/extra/penalty-hour tracking, imported from the company's
// attendance system rather than entered by the employee (see
// attendanceController.js for the CSV-import approach used in place of
// a live fingerprint-device feed).
// ---------------------------------------------------------------------
enum Shift {
  MORNING // 8:00 AM - 4:00 PM
  EVENING // 4:00 PM - 12:00 AM
  NIGHT   // 12:00 AM - 8:00 AM
}

enum AttendanceStatus {
  PRESENT
  LATE
  EARLY_LEAVE
  ABSENT
  DAY_OFF
  APPROVED_LEAVE
  INCOMPLETE
  PENDING_REVIEW
}

enum DayOffType {
  WEEKLY
  MONTHLY
  OTHER
}

// IMPORT  -> written by the Excel attendance import
// MANUAL  -> written directly by a staff member (no import row backing it)
// SYSTEM  -> written by the app itself (e.g. a LeaveRequest approval)
enum AttendanceSource {
  IMPORT
  MANUAL
  SYSTEM
}

enum LeaveRequestType {
  MONTHLY_OFF
  PERSONAL_LEAVE
  // A day off funded by an employee's accumulated extra-work-hours
  // balance (8 banked extra hours = 1 day off), instead of an
  // employer-granted monthly off day or unpaid personal leave. See
  // LeaveRequest.hoursSpent and attendanceController's balance
  // computation — there is no separate ledger table; the balance is
  // always derived from AttendanceRecord vs. already-APPROVED
  // EARNED_DAY_OFF requests, same "never store what can be computed"
  // convention as workingHours/attendanceRate.
  EARNED_DAY_OFF
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// ---------------------------------------------------------------------
// Cashier role — a second, genuinely different kind of Employee (own
// login identifier, own profile fields, own shift-gated feature set).
// Both WORKER and CASHIER are still the same Employee model/JWT `kind`,
// so every existing employee-scoped endpoint (Activities, Sudden Tasks,
// Attendance, Item Reports) keeps working for a Cashier token unchanged
// — only the two Cashier-only modules below (Cleaning, Price Report) are
// new. See cashierCleaningController.js / priceReportsController.js.
// ---------------------------------------------------------------------
enum EmployeeRole {
  WORKER
  CASHIER
  BUTCHER
}

// Only two values for Cashiers (unlike the three-shift Shift enum used by
// Attendance) — deliberately its own enum, not a reuse of `Shift`, since
// Cashiers are never on a Night shift per the spec.
enum CashierShift {
  MORNING
  EVENING
}

enum EmploymentStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
}

// Admin Phase 2 §15 — deliberately separate from EmploymentStatus above:
// employment status is an HR concept (is this person currently working
// here), account status is an authentication concept (can this specific
// login credential be used at all). A SUSPENDED/BANNED account and an
// ACTIVE employment status can coexist (e.g. suspended pending review,
// still employed) — merging them would make that unrepresentable.
enum AccountStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

// ---------------------------------------------------------------------
// Notifications — a real, generic feed (previously just a TODO comment
// in EmployeeWorkspace.jsx: "this toast is NOT a real notification
// system"). Written by the concrete actions that already exist: Sudden
// Task assignment, Leave request review, a new Chat message. Not wired
// into review steps that don't exist yet (e.g. Item Reports have no
// review endpoint) — no invented triggers.
// ---------------------------------------------------------------------
enum NotificationType {
  SUDDEN_TASK
  LEAVE_REVIEWED
  CHAT_MESSAGE
  ANNOUNCEMENT
  WASTED_OVERALL
  // A Supervisor approved/rejected an employee's Activity or Wasted
  // Overall report — one shared type for both, same as LEAVE_REVIEWED
  // covers both leave outcomes.
  SUBMISSION_REVIEWED
  // A Regional Manager sent a formal Warning or Recognition to a
  // market's Supervisor (MarketFeedback) — one shared type for both,
  // same reasoning as SUBMISSION_REVIEWED/LEAVE_REVIEWED above.
  MARKET_FEEDBACK
  // An employee submitted an AttendanceAdjustmentRequest (extra hours) —
  // notifies their market's Supervisor. The Supervisor's approve/reject
  // outcome reuses SUBMISSION_REVIEWED going back to the employee.
  EXTRA_HOURS_SUBMITTED
  // A Supervisor submitted a Total Sales report — notifies the market's
  // Regional Manager(s), the only role authorized to view it.
  TOTAL_SALES_SUBMITTED
  // A Supervisor or Overlooking account submitted a Card Sales report for
  // one shift — notifies the market's Regional Manager(s).
  CARD_SALES_SUBMITTED
  // A Regional Manager sent a reminder that today's Card Sales reporting
  // isn't complete yet — notifies the market's Supervisor and Overlooking
  // account (Market Activities §4).
  CARD_SALES_REMINDER
  // A Supervisor assigned an employee to count a DIFFERENT department
  // than their own — notifies the market's zone Regional/Zone Manager
  // that a CountingAssignment needs verification (see that model's own
  // comment).
  COUNTING_ASSIGNMENT_VERIFICATION_NEEDED
  // The Regional/Zone Manager verified a cross-department counting
  // assignment — notifies the Supervisor who created it.
  COUNTING_ASSIGNMENT_VERIFIED
  // checkIn is set, checkOut isn't, and it's well past when the employee
  // should have finished — notifies the employee (see
  // attendanceController's missing-checkout detection).
  MISSING_CHECKOUT
  // An employee accumulated an unusually large amount of extra working
  // time in a short window — notifies the market's zone Regional/Zone
  // Manager for review (spec: "not to automatically punish the
  // employee... trigger a management review").
  EXCESSIVE_EXTRA_HOURS
  // A Break entered PENDING_CONFIRMATION (fingerprint event, or a
  // controlled test/manual creation — see FingerprintEvent's own
  // comment) — notifies the employee/staff it's for: "Did you take a
  // break?" (Phase 1 foundation; the full UX is Phase 2).
  BREAK_PENDING_CONFIRMATION
  // A Break the recipient confirmed reached its expected end time
  // (ACTIVE -> COMPLETED).
  BREAK_COMPLETED
  // An employee (or an authorized Supervisor on their behalf) submitted
  // a Department Closing activity — notifies the market's Supervisor/
  // Overlooking (Phase 2 §11).
  DEPARTMENT_CLOSING_SUBMITTED
  // Admin Phase 2 §26 — an Admin suspended/banned/reactivated this
  // account. One shared type for all three outcomes, same convention as
  // SUBMISSION_REVIEWED/LEAVE_REVIEWED above.
  ACCOUNT_STATUS_CHANGED
  // Admin Phase 2 §26 — an Admin changed this person's role/assignment
  // (promotion, demotion, or a same-table role/market/zone change).
  ROLE_CHANGED
  // Admin Phase 3 §3 — an Admin started a formal Market Visit or
  // Administrative Inspection at this market — notifies its Supervisor.
  MARKET_VISIT
  // Night Shift §20 — a Night Shift task (e.g. Washing Market) was
  // completed — notifies the market's Supervisor/Overlooking Supervisor.
  NIGHT_SHIFT_TASK_COMPLETED
  // Warnings & Notifications — a targeted Communication was sent to this
  // employee. A lightweight pointer only (linkType "COMMUNICATION",
  // linkId = Communication.id) so it shows up in the existing
  // Notification Center for free; the full content/action UI reads the
  // real Communication + CommunicationRecipient rows, not this row.
  COMMUNICATION
  // Cleanup Phase §6 — an employee submitted an ItemReport (expired/
  // wasted item) or a Cashier submitted a PriceReport (shelf vs. system
  // price mismatch) — notifies the market's own Supervisor/Overlooking
  // Supervisor. One shared type for both, same convention as
  // SUBMISSION_REVIEWED/LEAVE_REVIEWED covering multiple related events.
  // These reports predate the Notification system and were never
  // retrofitted until now — this is the fix for "reports only ever
  // surfaced via Admin's global dashboards, never actively routed to the
  // Supervisor responsible for them."
  EMPLOYEE_REPORT_SUBMITTED
  // Production Chat §14-15 — someone was @mentioned in a real, structured
  // mention (never triggered by the raw string containing "@" — see
  // MessageMention). Recipient is whichever of employeeId/userId the
  // mentioned account actually is.
  MENTION
  // Production Chat §13 — an authorized management account (Supervisor/
  // Overlooking/Regional Manager/Admin) sent a Management Recognition
  // reaction to this employee's message (see MessageReaction.isRecognition).
  MANAGEMENT_RECOGNITION
}

// ---------------------------------------------------------------------
// Chat — market-scoped: one Market Group conversation, one Warnings
// (supervisor-announcement, employee-read-only) conversation, and any
// number of Direct 1:1 conversations between two employees in the same
// market. Polling-based (no WebSocket dependency — see
// chatController.js's listMessages ?after= param), consistent with the
// rest of this app's REST-only architecture.
// ---------------------------------------------------------------------
enum ConversationType {
  MARKET_GROUP
  WARNINGS
  DIRECT
  // A real, backend-persisted 1:1 conversation between one Employee and
  // their market's Supervisor (a staff User) — DIRECT above only ever
  // connects two Employees (participantAId/participantBId are both
  // Employee FKs), so it structurally cannot represent an Employee<->
  // Supervisor DM. This type uses participantAId (the Employee) +
  // staffParticipantId (the Supervisor's User id) instead.
  SUPERVISOR_DIRECT
  // Same shape as SUPERVISOR_DIRECT (participantAId = Employee,
  // staffParticipantId = the Regional Manager's User id) but with an
  // extra rule SUPERVISOR_DIRECT doesn't have: the employee can't
  // initiate it, and can't reply until the RM sends the first message —
  // see Conversation.locked below.
  RM_DIRECT
  // A Supervisor-created, named group with an explicit member list (spec
  // §6-8) — unlike MARKET_GROUP (implicitly every employee in the
  // market, no membership rows needed), a CUSTOM_GROUP's members are
  // real ConversationMember rows, added/removed individually. `name` and
  // `createdById` on Conversation are only meaningful for this type.
  CUSTOM_GROUP
  // Phase 3 — a real, backend-persisted 1:1 between two STAFF accounts
  // (Admin/Regional Manager/Supervisor/Overlooking), the one shape none
  // of the types above could represent (DIRECT is Employee-only,
  // SUPERVISOR_DIRECT/RM_DIRECT are always Employee<->one staff member).
  // Needed for "Important People" (spec §3-4): a Regional Manager's
  // high-priority contacts — CEO, Operations Manager, senior management —
  // are other staff accounts, not employees, and there was previously no
  // way for two staff members to have a real 1:1 conversation at all.
  // Uses staffParticipantId (A) + staffParticipantBId (B) below, ordered
  // consistently (lower id first) same as DIRECT's participantA/B
  // ordering — see chatController.js's directPair()/staffDirectPair().
  STAFF_DIRECT
  // Production Chat §6-7 — one, auto-provisioned (found-or-created, same
  // pattern as MARKET_GROUP) General Zone chat per Zone. Membership is
  // implicit: every employee whose market is in this zone, every
  // Supervisor/Overlooking of a market in this zone, the zone's Regional
  // Manager(s), and Admin — see chatController.js's
  // findOrCreateZoneChannel/conversationAccessFor. Uses Conversation.zoneId
  // (marketId stays null), never a CUSTOM_GROUP — a zone has exactly one
  // of these, not a manually-created, renameable group.
  ZONE_GROUP
  // Production Chat §8 — the zone-level counterpart to WARNINGS: read-only
  // for everyone in the zone, postable only by the zone's Regional
  // Manager(s) or Admin (see chatController.postZoneAnnouncement).
  ZONE_ANNOUNCEMENTS
}

// FILE/AUDIO/VOICE only — an image attachment is still represented by
// Message.imageUrl (pre-existing, already wired end to end); this enum
// exists so the frontend can pick the right playback/preview UI for the
// other three kinds without sniffing a raw MIME string.
enum MessageAttachmentType {
  FILE
  AUDIO
  VOICE
}

// ---------------------------------------------------------------------
// Staff (Admin / Regional Manager / Supervisor / Overlooking Supervisor)
// — logs in with email (Admin/Regional Manager) or loginId (Supervisor/
// Overlooking — a case-insensitive "User ID", same concept as
// Employee.employeeCode/username, see authController.staffIdLogin).
// loginId is nullable/optional rather than replacing email entirely:
// Admin/Regional Manager accounts have no User ID in this spec and keep
// using email exclusively; every account still has a real email either
// way (required for account creation/notifications), loginId is just an
// additional login path some roles use instead.
// ---------------------------------------------------------------------
model User {
  id           Int       @id @default(autoincrement())
  name         String
  email        String    @unique
  loginId      String?   @unique
  passwordHash String
  role         StaffRole @default(SUPERVISOR)
  createdAt    DateTime  @default(now())

  // Admin Phase 2 — account-status (auth eligibility, distinct from any
  // employment concept — staff accounts have no employment-status field
  // at all) + session invalidation. tokenVersion is embedded in every
  // JWT this account is issued (see utils/jwt.js); requireAuth compares
  // it against the current DB value on every request — bumping it here
  // makes every previously-issued token stop working immediately,
  // without a stateful session store (see middleware/auth.js's own
  // comment on why this is the "smallest correct" mechanism for a
  // stateless-JWT app).
  accountStatus AccountStatus @default(ACTIVE)
  statusReason  String?
  tokenVersion  Int           @default(0)

  // Repair Pass §3 — self-service profile fields for staff accounts
  // (Supervisor/Overlooking/Regional Manager/Admin), the same three an
  // Employee already had (see Employee.profilePictureUrl/whatsappNumber's
  // own comments) — added here instead of a second staff-profile table so
  // PATCH /api/profile stays the one shared self-service endpoint for
  // both account kinds (see profileController.updateMyProfile).
  profilePictureUrl String?
  phoneNumber       String?
  whatsappNumber    String?

  // Set only when this User account was created by promoting an
  // existing Employee (Worker/Cashier/Butcher -> Supervisor/Regional
  // Manager/Overlooking Supervisor) — see
  // adminAccountController.promoteEmployeeToStaff's own comment on why
  // this is a linked NEW account rather than an in-place row conversion
  // (Employee.id and User.id are different identity spaces referenced
  // by many dual-nullable-FK tables — converting in place would silently
  // orphan every historical Activity/AttendanceRecord/Message row still
  // pointing at the old employeeId). The old Employee row is preserved,
  // never deleted, with its own accountStatus set to SUSPENDED so it can
  // no longer log in.
  promotedFromEmployeeId String?   @unique
  promotedFromEmployee   Employee? @relation("EmployeePromotedToUser", fields: [promotedFromEmployeeId], references: [id])
  // Reverse side of Employee.demotedFromUserId — lets this User row (if
  // it was later demoted) be traced forward to the Employee row it
  // became.
  demotedToEmployee Employee? @relation("UserDemotedToEmployee")

  // A Regional Manager can manage multiple zones (Zone.managerId has no
  // uniqueness constraint) — the RM management layer explicitly needs
  // this ("Regional Manager -> manages multiple Zones"); a single-zone RM
  // is just the common case of this same relation, not a different shape.
  managedZones  Zone[]   @relation("ZoneManager")
  // A Supervisor manages exactly one market.
  managedMarket Market?  @relation("MarketSupervisor")
  // An OVERLOOKING_SUPERVISOR manages exactly one market too — its own
  // distinct account/login, not the Supervisor's (see Market's comment).
  managedOverlookingMarket Market? @relation("MarketOverlookingSupervisor")

  // Tasks this staff member has reviewed (approved/rejected).
  reviewedTasks Task[] @relation("TaskReviewer")
  // Tasks this staff member proactively assigned to an employee.
  assignedTasks Task[] @relation("TaskAssigner")

  // Sudden Tasks this staff member has pushed to an employee.
  assignedSuddenTasks SuddenTask[] @relation("SuddenTaskAssigner")

  // Products this staff member added to a market's inventory.
  createdProducts Product[] @relation("ProductCreator")

  // Attendance rows this staff member imported directly (legacy single-row
  // path — the real Excel import now goes through AttendanceImportBatch).
  importedAttendance AttendanceRecord[] @relation("AttendanceImporter")

  requiredHoursAdjustments AttendanceAuditLog[]       @relation("AttendanceAuditor")
  adjustedRequiredHours    RequiredHoursAdjustment[]  @relation("RequiredHoursAdjuster")
  uploadedAttendanceImports AttendanceImportBatch[]   @relation("AttendanceImportUploader")
  reviewedLeaveRequests    LeaveRequest[]             @relation("LeaveReviewer")
  assignedDepartments      DepartmentAssignment[]     @relation("DepartmentAssigner")
  reviewedWastedOverallReports WastedOverallReport[]  @relation("WastedOverallReviewer")
  notifications                Notification[]         @relation("NotificationRecipientUser")
  communicationsSent           Communication[]        @relation("CommunicationSender")
  communicationsTargetedAsSupervisor Communication[]  @relation("CommunicationTargetSupervisor")
  communicationsReceived       CommunicationRecipient[] @relation("CommunicationRecipientUser")

  sentMessages Message[] @relation("MessageSenderUser")
  supervisorConversations Conversation[] @relation("ConversationStaffParticipant")
  staffDirectConversationsAsB Conversation[] @relation("ConversationStaffParticipantB")
  reviewedActivities Activity[] @relation("ActivityReviewer")
  messageReactions MessageReaction[] @relation("MessageReactionUser")
  messageMentions MessageMention[] @relation("MessageMentionUser")

  marketVisits    MarketVisit[]    @relation("MarketVisitRM")
  adminMarketVisits MarketVisit[]  @relation("MarketVisitAdmin")
  auditLogsAsActor AuditLog[]      @relation("AuditLogActor")
  marketRatings   MarketRating[]   @relation("MarketRatingRM")
  marketNotes     MarketNote[]     @relation("MarketNoteRM")
  marketFeedbacks MarketFeedback[] @relation("MarketFeedbackRM")
  reportedMarketProblems MarketProblem[] @relation("MarketProblemReporter")
  createdGroups   Conversation[]   @relation("ConversationCreator")
  reviewedAttendanceAdjustments AttendanceAdjustmentRequest[] @relation("AttendanceAdjustmentReviewer")
  groupMemberships ConversationMember[] @relation("ConversationMemberUser")
  submittedTotalSalesReports TotalSalesReport[] @relation("TotalSalesSubmitter")
  reviewedTotalSalesReports  TotalSalesReport[] @relation("TotalSalesReviewer")
  submittedCardSalesReports  CardSalesReport[]  @relation("CardSalesSubmitter")
  sentCardSalesReminders     CardSalesReminder[] @relation("CardSalesReminderSender")
  createdCountingAssignments  CountingAssignment[] @relation("CountingAssignmentAssigner")
  verifiedCountingAssignments CountingAssignment[] @relation("CountingAssignmentVerifier")
  uploadedFiles               UploadedFile[]
  staffAttendanceRecords      AttendanceRecord[]   @relation("StaffAttendance")
  staffBreaks                 Break[]              @relation("StaffBreaks")
  departmentClosingsSubmitted Activity[]           @relation("ActivitySubmittedByStaff")
  createdMarketDepartments    MarketDepartment[]   @relation("MarketDepartmentCreator")
  sentDepartmentReports       DepartmentReport[]   @relation("DepartmentReportSender")

  staffConversationReads ConversationRead[] @relation("StaffConversationReads")
  importantContacts      ImportantContact[] @relation("ImportantContactOwner")
  importantContactOf     ImportantContact[] @relation("ImportantContactTargetUser")
  nightShiftTaskDefinitionsCreated NightShiftTaskDefinition[] @relation("NightShiftTaskDefinitionCreator")
}

// ---------------------------------------------------------------------
// Zone -> Market -> Employee
// ---------------------------------------------------------------------
model Zone {
  id     Int  @id @default(autoincrement())
  number Int  @unique
  // No longer @unique — one Regional Manager can be assigned multiple
  // zones (see User.managedZones's own comment). A single-zone RM is
  // still the common case; nothing about that changes.
  managerId Int?
  manager   User?    @relation("ZoneManager", fields: [managerId], references: [id])
  markets   Market[]
  conversations Conversation[]
  auditLogs AuditLog[]
  nightShiftTaskDefinitions NightShiftTaskDefinition[]
  communications Communication[]
  createdAt DateTime @default(now())

  @@index([managerId])
}

model Market {
  id           String       @id @default(cuid())
  name         String
  status       MarketStatus @default(ACTIVE)
  zoneId       Int
  zone         Zone         @relation(fields: [zoneId], references: [id])
  supervisorId Int?         @unique
  supervisor   User?        @relation("MarketSupervisor", fields: [supervisorId], references: [id])
  // The market's Night/Evening-shift counterpart — a real, distinct
  // account (StaffRole.OVERLOOKING_SUPERVISOR), not a shift label chosen
  // at login. Nullable: a market may not have a dedicated Overlooking
  // account yet, same as supervisorId. Deliberately mirrors supervisorId
  // exactly (own @unique FK) rather than a generic "market staff" list,
  // since the two roles have genuinely different permissions (e.g. only
  // the Supervisor can submit Total Sales — see totalSalesController.js).
  overlookingSupervisorId Int?  @unique
  overlookingSupervisor   User? @relation("MarketOverlookingSupervisor", fields: [overlookingSupervisorId], references: [id])
  employees    Employee[]
  tasks        Task[]
  suddenTasks  SuddenTask[]
  products     Product[]
  itemReports  ItemReport[]
  priceReports PriceReport[]
  wastedOverallReports WastedOverallReport[]
  leaveRequests LeaveRequest[]
  attendanceImportBatches AttendanceImportBatch[]
  attendanceRecords AttendanceRecord[]
  breaks            Break[]
  departments       MarketDepartment[]
  departmentReports DepartmentReport[]
  activities        Activity[]
  conversations Conversation[]
  createdAt    DateTime     @default(now())

  visits    MarketVisit[]
  ratings   MarketRating[]
  notes     MarketNote[]
  feedbacks MarketFeedback[]
  problems  MarketProblem[]

  totalSalesReports TotalSalesReport[]
  cardSalesReports  CardSalesReport[]
  cardSalesReminders CardSalesReminder[]
  auditLogs         AuditLog[]
  nightShiftTaskDefinitions NightShiftTaskDefinition[]
  communications Communication[]

  @@index([zoneId])
}

// Employees log in with an employeeCode + password, not an email — this
// matches the frontend's "find yourself" login flow for the Employee role.
//
// employeeCode/passwordHash are nullable to support a "pending" hire —
// an Employee row created before credentials are assigned (spec: "do
// not invent credentials, leave User ID and password unassigned until
// provided"). Login lookups naturally never match a NULL employeeCode
// (see authController.employeeLogin's own comment), and
// employeeLogin/cashierLogin explicitly reject a null passwordHash with
// a clear "not yet activated" error rather than attempting
// bcrypt.compare against it. A staff member assigns both together later
// via PATCH /api/employees/:id (see employeesController.updateEmployee).
model Employee {
  id            String       @id @default(cuid())
  employeeCode  String?      @unique
  name          String
  passwordHash  String?
  position      String
  secondaryRole String?
  shift         String?
  // Night Shift — the authoritative, enum-typed shift, reusing the exact
  // Shift enum (MORNING/EVENING/NIGHT) AttendanceRecord/DepartmentReport
  // already use, rather than the free-text `shift` field above (which
  // stays untouched — existing screens display it as-is, e.g. "Morning
  // Shift"/"Afternoon Shift"/"Night", and nothing here repurposes or
  // migrates that data). Only WORKER/BUTCHER roles are eligible for
  // NIGHT here (enforced in the controller, not the DB) — CASHIER keeps
  // its own separate cashierShift below, whose CashierShift enum has no
  // NIGHT value at all by existing, intentional design ("Cashiers are
  // never on a Night shift").
  operationalShift Shift?
  role          EmployeeRole @default(WORKER)
  marketId      String
  market        Market       @relation(fields: [marketId], references: [id])
  tasks         Task[]
  createdAt     DateTime     @default(now())

  // Admin Phase 2 — same accountStatus/tokenVersion convention as User
  // (see that model's own comment); deliberately separate from
  // employmentStatus below (an HR concept), not a replacement for it.
  accountStatus AccountStatus @default(ACTIVE)
  statusReason  String?
  tokenVersion  Int           @default(0)

  // Set only when this Employee row is the result of demoting an
  // existing User (Supervisor/Regional Manager/Overlooking Supervisor ->
  // Worker/Cashier/Butcher) — see
  // adminAccountController.demoteStaffToEmployee's own comment. The
  // original User row is preserved, never deleted, with accountStatus
  // set to SUSPENDED.
  demotedFromUserId Int?  @unique
  demotedFromUser   User? @relation("UserDemotedToEmployee", fields: [demotedFromUserId], references: [id])
  // Reverse side of User.promotedFromEmployeeId — lets this Employee row
  // (if it was later promoted) be traced forward to the User account it
  // became.
  promotedToUser User? @relation("EmployeePromotedToUser")

  // --- Employee Profile fields (Phase 1, Step 2) ---
  // All nullable/optional so existing employee rows don't break and none
  // of these are calculated yet — they're just places to store the data
  // once the matching feature (photo upload, real performance calc) exists.
  profilePictureUrl String?   // URL of an uploaded photo; no upload feature yet.
  startDate         DateTime? // The employee's real hire date (different from
                               // createdAt, which is just "when the DB row
                               // was created" and may not match reality).
  performanceRate   Int?      // Placeholder for a future calculated score.
                               // Nothing writes to this yet — see Step 7.

  // username/cashierShift stay Cashier-only (null for a WORKER) — separate
  // login identifier namespace, a Worker keeps logging in with employeeCode.
  username     String?       @unique
  cashierShift CashierShift? // drives whether Cleaning is shown

  // department applies to EVERY employee now (Worker or Cashier) — kept
  // as a fast denormalized "current department" cache, synced whenever a
  // new DepartmentAssignment is created; that table is the historical
  // source of truth (see DepartmentAssignment below).
  department       String?
  employmentStatus EmploymentStatus @default(ACTIVE)
  whatsappNumber   String?                   // tap-to-open wa.me link on the profile

  activities Activity[]
  suddenTasks SuddenTask[]
  itemReports ItemReport[]
  attendanceRecords         AttendanceRecord[]
  requiredHoursAdjustments  RequiredHoursAdjustment[]
  cashierCleaningLogs       CashierCleaningLog[]
  priceReports              PriceReport[]
  wastedOverallReports      WastedOverallReport[]
  leaveRequests             LeaveRequest[]
  departmentAssignments     DepartmentAssignment[]
  auditLogEntries           AttendanceAuditLog[]

  notifications         Notification[]
  communicationsReceived CommunicationRecipient[]
  sentMessages          Message[]          @relation("MessageSenderEmployee")
  conversationReads     ConversationRead[]
  directConversationsAsA Conversation[]    @relation("ConversationParticipantA")
  directConversationsAsB Conversation[]    @relation("ConversationParticipantB")
  messageReactions      MessageReaction[]  @relation("MessageReactionEmployee")
  messageMentions       MessageMention[]   @relation("MessageMentionEmployee")
  groupMemberships      ConversationMember[]
  attendanceAdjustmentRequests AttendanceAdjustmentRequest[]
  countingAssignments   CountingAssignment[]
  uploadedFiles         UploadedFile[]
  breaks                Break[]
  fingerprintEvents     FingerprintEvent[]
  importantContactOf    ImportantContact[] @relation("ImportantContactTargetEmployee")

  @@index([marketId])
  @@index([operationalShift])
}

// ---------------------------------------------------------------------
// Task — the daily-activity submission / assignment / review workflow.
//
// NOTE: as of the Sudden Tasks module, this model has no frontend caller
// anywhere (no `taskService.js` exists) even though every endpoint below
// is implemented and tested. It was NOT reused for Sudden Tasks because
// `type` is an activity-shaped enum (FACING/REFILLING/...), not a
// freeform title+description+priority. Leaving this here unused rather
// than deleting it — it's a reasonable base for a future "Supervisor
// assigns a normal activity-shaped task" feature, but that's a decision
// for whoever builds the Supervisor module, not this change.
// ---------------------------------------------------------------------
model Task {
  id         String     @id @default(cuid())
  type       TaskType
  label      String
  department String
  notes      String?
  status     TaskStatus @default(PENDING)

  requiresPhoto  Boolean @default(false)
  // No file upload service is wired up yet — these hold a URL/path once
  // one exists. Left nullable so the API works before that's built.
  beforePhotoUrl String?
  afterPhotoUrl  String?

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  marketId   String
  market     Market   @relation(fields: [marketId], references: [id])

  // Set when a supervisor/manager proactively assigns this task instead
  // of the employee submitting it on their own initiative.
  assignedById Int?
  assignedBy   User?   @relation("TaskAssigner", fields: [assignedById], references: [id])

  reviewedById     Int?
  reviewedBy       User?     @relation("TaskReviewer", fields: [reviewedById], references: [id])
  rejectionReason  String?
  reviewedAt       DateTime?

  submittedAt DateTime  @default(now())
  createdAt   DateTime  @default(now())

  @@index([employeeId])
  @@index([marketId])
  @@index([status])
}

// ---------------------------------------------------------------------
// Activity — an employee's own daily activity log (Phase 1, Step 3/4).
// This is intentionally separate from Task: Task is "a supervisor gave
// me work to do", Activity is "I'm logging work I did on my own". Same
// review lifecycle shape (submit -> approve/reject) but a different
// reason for existing, so we do not merge them (Step 6).
model Activity {
  id       String           @id @default(cuid())
  category ActivityCategory
  date     DateTime
  time     String // e.g. "9:15 AM" — stored as text to mirror what the
                   // frontend already generates; no timezone-math is
                   // needed for a simple "what time did this happen" label.
  notes    String?
  status   ActivityStatus @default(DRAFT)

  // Set by a Supervisor's review (approve/reject) — mirrors Task's own
  // reviewedById/rejectionReason/reviewedAt shape exactly, since this is
  // the same "submit -> approve/reject" lifecycle, just for a
  // self-initiated Activity instead of a supervisor-assigned Task.
  reviewedById    Int?
  reviewedBy      User?     @relation("ActivityReviewer", fields: [reviewedById], references: [id])
  rejectionReason String?
  reviewedAt      DateTime?

  // Only meaningful for category = LABEL_CHECKING — the scanned/searched
  // Product the label issue was found on (same product-search flow as
  // ItemReport), and what's wrong with it. Null for every other category.
  productId      String?
  product        Product?        @relation(fields: [productId], references: [id])
  labelIssueType LabelIssueType?

  // Only meaningful for category = ITEM_COUNTING — which CountingAssignment
  // (department + specific area) this submission was performed against,
  // so the record carries its own "assignment/authorization information"
  // (spec §4) rather than just a bare photo with no context. Null for
  // every other category, and null here too if the employee submitted
  // without ever having an explicit assignment (falls back to their
  // plain department — see countingAssignmentsController.getMyAssignment).
  countingAssignmentId String?
  countingAssignment    CountingAssignment? @relation(fields: [countingAssignmentId], references: [id])

  // Only meaningful for category = DEPARTMENT_CLOSING — which department
  // this "how did you leave it" submission is about. A plain string
  // (matching Employee.department/DepartmentAssignment.department's own
  // convention), not a hard FK to MarketDepartment below — a submission
  // should stay readable even if that catalog row is later renamed/
  // deactivated, same "the historical record doesn't retroactively
  // change" principle used throughout this schema (e.g. Message.
  // forwardedFromSenderName).
  department String?

  // Set only when a Supervisor/Overlooking submits this DEPARTMENT_CLOSING
  // activity on the employee's behalf (spec: "whether submitted by
  // employee or authorized supervisor") — null means the employee
  // submitted it themself, the default for every other Activity category
  // too. Authorization for who's "authorized" to do this for which
  // employee is the same assertMarketAccess every staff-scoped endpoint
  // already uses (see activitiesController.createActivity).
  //
  // Phase 2 (§15-16): a Supervisor can ALSO submit a Department Closing
  // for a genuinely UNASSIGNED department — no employee exists to
  // attribute it to at all. That's the one case employeeId below is
  // null; submittedByStaffId is then the sole owner, and marketId (also
  // otherwise unused/null — every other case derives market via
  // employee.marketId) carries the market this submission belongs to.
  // Never both employeeId AND marketId null at once for a real Activity
  // row — enforced in activitiesController, not the DB.
  submittedByStaffId Int?
  submittedByStaff   User? @relation("ActivitySubmittedByStaff", fields: [submittedByStaffId], references: [id])

  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id])
  marketId   String?
  market     Market?  @relation(fields: [marketId], references: [id])

  // Night Shift (only meaningful for category = NIGHT_SHIFT_TASK) — which
  // reusable task this instance fulfills, and which OPERATIONAL day it
  // belongs to. A Night Shift crosses midnight (spec: "starts 10 PM,
  // completes 1:30 AM belongs to the PREVIOUS day's shift"), so
  // operationalDate is deliberately a separate, explicitly-set field
  // rather than derived from createdAt/date — createdAt stays the real
  // server timestamp evidence was submitted, operationalDate is which
  // shift-day this counts toward for reporting/duplicate-prevention.
  // The @@unique below is the actual idempotent-generation guarantee
  // (same pattern as DepartmentReport's @@unique([marketId, date,
  // shift])) — Postgres treats every NULL as distinct, so it only
  // constrains real Night Shift task rows, never collides with any
  // other Activity category.
  nightShiftTaskDefinitionId String?
  nightShiftTaskDefinition   NightShiftTaskDefinition? @relation(fields: [nightShiftTaskDefinitionId], references: [id])
  operationalDate            DateTime?

  images ActivityImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, nightShiftTaskDefinitionId, operationalDate])
  @@index([employeeId])
  @@index([status])
  @@index([nightShiftTaskDefinitionId])
}

// One Activity can have many images, and each image belongs to exactly
// one Activity (Step 5) — instead of fixed photo1/photo2/photo3 columns
// on Activity, which would cap how many images an activity can ever have
// and waste columns whenever there are fewer. This scales to any number
// of images with no future schema change.
model ActivityImage {
  id  String @id @default(cuid())
  url String

  // Retention deadline for this specific image — currently only set for
  // DEPARTMENT_CLOSING photos (16 hours from submission, spec §15);
  // null for every other Activity category's images, which stay
  // permanent like the rest of this app's task metadata (see
  // Frontend/README.md's "Photo retention" note for the same
  // metadata-vs-media-retention split already established for other
  // photo types). Enforced by services/maintenanceScheduler.js's
  // periodic sweep — see expiredAt below for how that sweep records
  // that it actually ran for this row.
  expiresAt DateTime?

  // Set by the expiry sweep once it has deleted the physical file/
  // UploadedFile row for this image (Phase 2) — null means "not expired
  // yet" (or never had an expiry at all). The row itself and `url` are
  // NEVER deleted when this is set: `url` stays as a historical record
  // of what was submitted, but GET /api/uploads/:filename for it will
  // correctly 404 (the UploadedFile row backing it is gone) — this field
  // just lets the frontend show "Photo expired" proactively instead of
  // attempting a fetch that's guaranteed to fail. Deliberately a
  // timestamp, not a boolean, so "when did this expire" is itself part
  // of the historical record.
  expiredAt DateTime?

  activityId String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([activityId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------
// NightShiftTaskDefinition — Night Shift §8: the reusable, admin-
// configured task ARCHITECTURE ("Washing Market is the first required
// implementation, not a special architecture future tasks cannot
// reuse"). One row per task type; every actual instance an employee
// works on is a plain Activity row (category NIGHT_SHIFT_TASK) linking
// back here — see Activity.nightShiftTaskDefinitionId's own comment.
// Restriction fields are all nullable = "no restriction on this axis"
// (e.g. marketId null means every market gets this task, not none).
model NightShiftTaskDefinition {
  id          String @id @default(cuid())
  key         String @unique // stable machine key, e.g. "WASHING_MARKET"
  name        String
  description String?

  shift                  Shift   @default(NIGHT)
  departmentRestriction  String? // null = any department; matches Employee/DepartmentAssignment's plain-string department convention
  marketId               String?
  market                 Market? @relation(fields: [marketId], references: [id])
  zoneId                 Int?
  zone                   Zone?   @relation(fields: [zoneId], references: [id])

  requiresEvidence Boolean                       @default(false)
  minPhotos        Int                           @default(0)
  frequency        NightShiftTaskFrequency        @default(DAILY)
  dueTime          String? // free-text clock time, e.g. "06:00" — mirrors Activity.time's own "stored as text" convention
  reviewRequired   Boolean                       @default(false)
  active           Boolean                       @default(true)

  createdById Int
  createdBy   User   @relation("NightShiftTaskDefinitionCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  instances Activity[]

  @@index([active])
  @@index([marketId])
  @@index([zoneId])
}

enum NightShiftTaskFrequency {
  DAILY
  ONCE
  WEEKLY
}

// ---------------------------------------------------------------------
// MarketDepartment — Phase 2: the per-market department CATALOG, genuinely
// new (nothing like it existed after Phase 1). Needed because "which
// departments does this market track" cannot be derived from current
// DepartmentAssignment rows alone — an UNASSIGNED department (spec §15:
// "Dairy — Unassigned — Needs Supervisor") has, by definition, no
// assignment row to derive it from. This is the actual configuration
// Phase 2's completion tracking ("8 required, 6 completed") reads from —
// never a hardcoded count. A row here is auto-created the first time a
// department name is used in that market (DepartmentAssignment or a
// Department Closing submission — see
// departmentMonitoringService.ensureMarketDepartment) OR added explicitly
// by staff via POST /api/markets/:id/departments (covers a department
// that should be tracked before anyone is ever assigned to it).
//
// Employee.department/DepartmentAssignment.department/Activity.department
// all stay plain strings, matching this table's `name` by value, not by
// a hard foreign key — see Activity.department's own comment for why.
model MarketDepartment {
  id       String @id @default(cuid())
  marketId String
  market   Market @relation(fields: [marketId], references: [id])
  name     String
  active   Boolean @default(true)

  createdById Int?
  createdBy   User? @relation("MarketDepartmentCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@unique([marketId, name])
  @@index([marketId])
}

// ---------------------------------------------------------------------
// DepartmentReport — one row per market/date/shift Final Department
// Report actually sent (Phase 2 §19-22). The @@unique below is the real
// guarantee against two concurrent "Send Report" requests both
// succeeding for the same market/day/shift (same partial-unique-index
// philosophy as Break's one-active-break guarantee, except this
// constraint doesn't need a WHERE clause — every row here represents an
// actually-sent report, so a plain unique index is enough). A snapshot
// of the completion counts and whether an override was used is stored
// directly on this row — the underlying Activity rows remain the one
// source of truth for the submissions THEMSELVES (spec §13/§20: this
// table never duplicates that data, only records that a report citing
// it was sent, when, by whom, and where).
model DepartmentReport {
  id       String @id @default(cuid())
  marketId String
  market   Market @relation(fields: [marketId], references: [id])
  date     DateTime // day-only, same convention as AttendanceRecord.date
  shift    Shift

  requiredCount  Int
  completedCount Int
  overrideUsed   Boolean @default(false)
  overrideReason String?

  sentById Int
  sentBy   User     @relation("DepartmentReportSender", fields: [sentById], references: [id])
  sentAt   DateTime @default(now())

  // Where the report message was actually posted — the market's own
  // MARKET_GROUP conversation (see chatController.findOrCreateChannel),
  // never a hardcoded/invented "Zone" group.
  conversationId String?
  messageId      String?

  @@unique([marketId, date, shift])
  @@index([marketId, date])
}

// ---------------------------------------------------------------------
// SuddenTask — a Supervisor/Manager/Admin pushing an urgent task at an
// employee (see the SuddenTaskPriority/SuddenTaskStatus comment above for
// why this is its own model, separate from both Task and Activity).
// ---------------------------------------------------------------------
model SuddenTask {
  id          String             @id @default(cuid())
  title       String
  description String
  priority    SuddenTaskPriority @default(NORMAL)
  status      SuddenTaskStatus   @default(ASSIGNED)
  // Set by completeSuddenTask when the supervisor requires photo evidence
  // — previously completion was a bare status flip with nowhere to put
  // the photo the spec explicitly asks for.
  evidenceUrl String?

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  marketId   String
  market     Market   @relation(fields: [marketId], references: [id])

  assignedById Int
  assignedBy   User   @relation("SuddenTaskAssigner", fields: [assignedById], references: [id])

  assignedAt  DateTime  @default(now())
  completedAt DateTime?

  @@index([employeeId])
  @@index([marketId])
  @@index([status])
}

// ---------------------------------------------------------------------
// Product — a minimal per-market inventory catalog, just enough to back
// the Expired/Wasted Items report-and-decrement flow. No real
// Inventory/Indent Management system exists to integrate with, so this
// is the system of record for stock quantity until one does.
// ---------------------------------------------------------------------
model Product {
  id            String   @id @default(cuid())
  barcode       String
  name          String
  stockQuantity Int      @default(0)
  // The product's real selling price — nullable, since not every product
  // in this catalog has had one entered yet (see productsController.js).
  // Powers the Cashier Price Lookup flow: a product with no price set
  // shows "Price not set" honestly rather than a fabricated number.
  price         Float?

  marketId String
  market   Market @relation(fields: [marketId], references: [id])

  createdById Int
  createdBy   User @relation("ProductCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  itemReports ItemReport[]
  labelActivities Activity[]

  // Same barcode can be separate stock in different markets, so the
  // uniqueness is per-market, not global.
  @@unique([barcode, marketId])
  @@index([marketId])
}

// ItemReport — an employee reporting a Product as expired or wasted.
// Submitting one immediately decrements Product.stockQuantity in the
// same transaction (see itemReportsController.js) — no manual inventory
// adjustment from a supervisor required, per the spec. `status` exists
// for audit/review purposes only; it does not gate the stock decrement.
model ItemReport {
  id          String         @id @default(cuid())
  condition   ItemCondition
  quantity    Int
  status      ActivityStatus @default(PENDING)
  notes       String?
  imageUrl    String?

  productId String
  product   Product @relation(fields: [productId], references: [id])

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  marketId   String
  market     Market   @relation(fields: [marketId], references: [id])

  reportedAt DateTime @default(now())

  // Soft delete — staff can remove a report from view (see
  // itemReportsController.deleteItemReport); the row is kept, never
  // hard-deleted, same convention as Notification.deletedAt.
  deletedAt DateTime?

  @@index([employeeId])
  @@index([productId])
  @@index([marketId])
  @@index([reportedAt])
}

// ---------------------------------------------------------------------
// AttendanceRecord — one employee's attendance for one day: status,
// shift, check-in/out, break times, and required hours for that day.
// Populated by importAttendanceRecords (a staff-side Excel import — see
// attendanceController.js) rather than a live fingerprint-device feed,
// which isn't reachable from this app. Working hours are computed from
// checkIn/checkOut/break, not stored, so there's no redundant derived
// value to drift out of sync — requiredHours IS stored (not computed)
// because it's a real, independently-set value (default 8, overridable
// per day by a RequiredHoursAdjustment), not derived from anything else.
// ---------------------------------------------------------------------
model AttendanceRecord {
  id            String           @id @default(cuid())
  date          DateTime // the day this record is for; time part is ignored
  status        AttendanceStatus @default(PRESENT)
  shift         Shift?
  checkIn       DateTime?
  checkOut      DateTime?
  breakStart    DateTime?
  breakEnd      DateTime?
  dayOffType    DayOffType? // only meaningful when status = DAY_OFF
  requiredHours Int              @default(8) // 4-16, enforced in validate.js
  // Explicit penalty hours for this day, set only by staff (see
  // attendanceController.setPunishmentHours) — unlike extra hours (always
  // derived as max(workingHours - requiredHours, 0), never stored, same
  // as workingHours itself), a penalty has no computable source of truth
  // and must be recorded directly.
  punishmentHours Float          @default(0)
  // Why the penalty was applied — was previously only written to
  // AttendanceAuditLog (audit-only, never fetched by the employee-facing
  // endpoint), so the employee had no way to see it even though the
  // supervisor entered one. Stored directly on the record now, exactly
  // like RequiredHoursAdjustment.reason for extra/reward hours, so both
  // behave the same way to the employee.
  punishmentReason String?
  source        AttendanceSource @default(MANUAL)
  // The original imported row, preserved verbatim for audit purposes
  // (spec: "Preserve the original imported data") — only set when
  // source = IMPORT.
  rawImportData Json?

  // Missing-checkout detection (spec: "Check-out not detected. Are you
  // still working?"). Set the first time this record is flagged
  // (checkIn present, checkOut absent, well past when the shift should
  // have ended) so the same day is never re-notified on every page load —
  // see attendanceController.detectMissingCheckout. stillWorkingConfirmedAt
  // is set when the employee taps "Yes" — it doesn't change how extra
  // hours are computed by itself (that still needs a real checkOut,
  // eventually supplied by the next import or a manual correction); it's
  // an acknowledgement/audit marker, not a substitute for real data.
  missingCheckoutAlertedAt DateTime?
  stillWorkingConfirmedAt  DateTime?

  // Nullable as of the cross-role attendance extension (Phase 1): a
  // Supervisor/Overlooking check-in has no Employee at all — see
  // staffUserId below. Every EXISTING employee-attendance code path
  // (import, extra-hours, required-hours, punishment, missing-checkout)
  // is untouched and always supplies employeeId, so this stays optional
  // in the schema only for the genuinely new staff-owned rows.
  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id])

  // Set instead of employeeId for a Supervisor/Overlooking Supervisor's
  // own check-in/check-out (see attendanceController.checkIn) — same
  // dual-nullable-FK pattern already used by Message.sender/
  // ConversationMember/UploadedFile elsewhere in this schema, exactly
  // one of employeeId/staffUserId is ever set, enforced in the
  // controller. Deliberately does NOT carry Worker/Cashier-only
  // business logic (extra hours, required hours, punishment, Excel
  // import) — a Supervisor's attendance is check-in/check-out/history
  // only, per spec; this is the same table and same live check-in
  // mechanism, not a parallel attendance system.
  staffUserId Int?
  staffUser   User? @relation("StaffAttendance", fields: [staffUserId], references: [id])

  // Denormalized cache of the market this record belongs to — required
  // for staff-owned rows (no Employee to derive it from); left null on
  // existing/imported employee rows rather than backfilled, since every
  // existing query already reaches market scope via employee.marketId
  // and nothing reads AttendanceRecord.marketId for those rows. New
  // employee check-in/out rows (see attendanceController.checkIn) do
  // populate it too, so it's consistently available going forward.
  marketId String?
  market   Market? @relation(fields: [marketId], references: [id])

  importedById Int?
  importedBy   User? @relation("AttendanceImporter", fields: [importedById], references: [id])

  importBatchId String?
  importBatch   AttendanceImportBatch? @relation(fields: [importBatchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One record per employee per day — makes re-importing the same export
  // file idempotent (upsert on this constraint) instead of duplicating rows.
  // Postgres treats NULL as distinct in a unique index, so this constraint
  // simply never matches staff-owned rows (employeeId always null there) —
  // @@unique([staffUserId, date]) below is that same idea for staff.
  @@unique([employeeId, date])
  @@unique([staffUserId, date])
  @@index([employeeId])
  @@index([staffUserId])
  @@index([date])
}

// RequiredHoursAdjustment — a supervisor's override of an employee's
// required hours for one specific date (e.g. "8 -> 7, reward for
// exceptional performance"). Kept as its own append-only history table
// (never edited/deleted) so the full previous/new/reason/who/when trail
// survives even though AttendanceRecord.requiredHours itself is mutable
// (always reflects the CURRENT value). Replaces the earlier
// REWARD/EXTRA/PENALTY hour-delta model — that shape never matched what
// this spec actually needs (a direct override, not a delta), and nothing
// depended on the old shape (no Supervisor UI ever created one).
model RequiredHoursAdjustment {
  id                    String   @id @default(cuid())
  date                  DateTime // the day this adjustment applies to
  previousRequiredHours Int
  newRequiredHours      Int // 4-16, enforced in validate.js
  reason                String

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  adjustedById Int
  adjustedBy   User @relation("RequiredHoursAdjuster", fields: [adjustedById], references: [id])

  createdAt DateTime @default(now())

  @@index([employeeId])
  @@index([date])
}

// AttendanceImportBatch — one row per Excel attendance import, tracking
// who/when/how-many so every import is auditable and repeat-safe (spec
// §5/§16). AttendanceRecord.importBatchId links every record the batch
// touched back to it.
model AttendanceImportBatch {
  id             String   @id @default(cuid())
  fileName       String?
  periodStart    DateTime
  periodEnd      DateTime
  totalRecords   Int
  createdCount   Int
  updatedCount   Int
  unmatchedCount Int
  rejectedCount  Int
  errors         Json // [{ row, employeeCode?, message }]
  importedAt     DateTime @default(now())

  marketId String
  market   Market @relation(fields: [marketId], references: [id])

  uploadedById Int
  uploadedBy   User @relation("AttendanceImportUploader", fields: [uploadedById], references: [id])

  records AttendanceRecord[]

  @@index([marketId])
}

// ---------------------------------------------------------------------
// Break — Phase 1 foundation for the fingerprint-triggered break
// workflow (spec: "Did you take a break?"). A genuinely new model, not a
// reuse of AttendanceRecord.breakStart/breakEnd: those two fields are a
// same-day, no-state, no-confirmation pair (fine for what an Excel
// import can report), whereas this needs a persistent state machine,
// confirmation step, race-condition-safe "one active break" guarantee,
// and an optional link back to the external event that triggered it —
// none of which the existing pair can represent. Owner is EITHER an
// Employee OR a staff User (Supervisor/Overlooking), same dual-nullable
// pattern as AttendanceRecord.staffUserId above, for the same reason.
//
// One active (PENDING_CONFIRMATION or ACTIVE) break per owner is
// enforced by a partial unique index added by hand in this model's
// migration.sql (Prisma's schema language can't express a WHERE clause
// on @@unique) — see that migration file's own comment. That index, not
// an application-level "if no active break, create one" check, is what
// actually prevents two concurrent requests from creating duplicate
// active breaks; the controller still checks first for a fast, friendly
// error, but the database is the real guarantee.
model Break {
  id     String      @id @default(cuid())
  status BreakStatus @default(PENDING_CONFIRMATION)
  date   DateTime // the day this break belongs to; time part ignored, matches AttendanceRecord's convention

  // Set only once the employee confirms (PENDING_CONFIRMATION -> ACTIVE).
  // expectedEndTime is startTime + 60 minutes, set atomically with it —
  // remaining time is always (expectedEndTime - now), never a stored
  // countdown (spec: "the server/database is authoritative").
  startTime       DateTime?
  expectedEndTime DateTime?
  // Set when the break actually leaves ACTIVE, whichever way: the
  // moment it's read past expectedEndTime (-> COMPLETED, see
  // breaksController's lazy transition, same pattern as
  // attendanceController.detectMissingCheckout — no background job
  // scheduler exists in this app yet) or when explicitly cancelled.
  actualEndTime DateTime?
  cancelReason  String?

  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id])
  staffUserId Int?
  staffUser   User?    @relation("StaffBreaks", fields: [staffUserId], references: [id])
  marketId   String
  market     Market   @relation(fields: [marketId], references: [id])

  // The fingerprint event that created this break, if any (see
  // FingerprintEvent below) — nullable because Phase 1 also needs a
  // path for a break created without hardware yet involved (e.g. a
  // manual/test break for development). @unique: one event can only
  // ever originate one break.
  fingerprintEventId String?          @unique
  fingerprintEvent    FingerprintEvent? @relation(fields: [fingerprintEventId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([staffUserId])
  @@index([marketId])
  @@index([status])
}

enum BreakStatus {
  PENDING_CONFIRMATION
  ACTIVE
  COMPLETED
  CANCELLED
}

// ---------------------------------------------------------------------
// FingerprintEvent — Phase 1's integration BOUNDARY for the physical
// fingerprint machine, not a real connection to it (no such hardware/API
// access exists yet — see backend/src/services/fingerprintAdapter.js's
// own comment for exactly what's real vs. a stand-in here). Every event
// TeamMart will ever need to react to, regardless of which real system
// eventually sends it, is captured by this one row: an idempotency key
// from that system, which employee it's about, when it happened, what
// kind of event it was, which device reported it, and the raw payload
// preserved verbatim (same "preserve the original data" convention
// AttendanceRecord.rawImportData already uses for Excel rows) so nothing
// is lost even before TeamMart has a rule for every field yet.
model FingerprintEvent {
  id              String                @id @default(cuid())
  externalEventId String                @unique // dedupe key from the external system — the same physical scan is never double-processed
  eventType       FingerprintEventType
  eventTimestamp  DateTime
  sourceDeviceId  String?
  rawPayload      Json?

  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id])

  processedAt DateTime? // set once the event has been turned into a Break (or rejected) — lets a retry distinguish "new" from "already handled"
  break       Break?

  createdAt DateTime @default(now())

  @@index([employeeId])
  @@index([eventTimestamp])
}

// Deliberately just one value for Phase 1 — the only fingerprint event
// this app currently has a defined reaction to (spec: break confirmation
// flow). CHECK_IN/CHECK_OUT event types are a real, likely future
// addition once the actual hardware/protocol is confirmed, not invented
// here ahead of that.
enum FingerprintEventType {
  BREAK_START
}

// LeaveRequest — an employee requesting a Monthly Off day or Personal
// Leave for a specific date, reviewed by their Supervisor. Approving one
// upserts the matching AttendanceRecord (DAY_OFF or APPROVED_LEAVE) in
// the same transaction, so the calendar never shows a conflicting
// "Present" day for an approved leave (spec §11).
model LeaveRequest {
  id          String              @id @default(cuid())
  date        DateTime
  type        LeaveRequestType
  reason      String? // required for PERSONAL_LEAVE, enforced in validate.js
  // Only set (and only meaningful) for type = EARNED_DAY_OFF — how many
  // extra-hours-balance hours this request spends. Re-validated against
  // the employee's current balance at both create and approve time (see
  // leaveRequestsController) — approve time is authoritative since the
  // balance can change between request and review.
  hoursSpent  Int?
  status      LeaveRequestStatus  @default(PENDING)
  submittedAt DateTime            @default(now())

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  marketId   String // denormalized for the Supervisor review-queue query
  market     Market  @relation(fields: [marketId], references: [id])

  reviewedById Int?
  reviewedBy   User?     @relation("LeaveReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  reviewNote   String?

  // One request per employee per date — a second submission for the same
  // day is a clean 409 (existing errorHandler.js P2002 handling), not a
  // duplicate row.
  @@unique([employeeId, date])
  @@index([marketId])
  @@index([status])
}

// AttendanceAuditLog — generic audit trail for attendance-adjacent
// mutations (required-hours adjustments, leave approve/reject, imports,
// future manual corrections). One row per action, append-only. Spec §13
// asks for exactly this: who, what changed, previous value, new value,
// reason, when.
model AttendanceAuditLog {
  id     String @id @default(cuid())
  action String // "REQUIRED_HOURS_ADJUSTED" | "LEAVE_APPROVED" | "LEAVE_REJECTED" | "ATTENDANCE_IMPORTED" | ...

  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id])

  performedById Int
  performedBy   User @relation("AttendanceAuditor", fields: [performedById], references: [id])

  previousValue Json?
  newValue      Json?
  reason        String?

  createdAt DateTime @default(now())

  @@index([employeeId])
  @@index([createdAt])
}

// DepartmentAssignment — history of which department an employee belonged
// to and when (spec §3: "store department assignment history"). Applies
// to every employee (Worker or Cashier). Employee.department is kept as
// a fast denormalized cache of whichever assignment has endDate = null
// (the current one); this table is the source of truth for "what
// department were they in on date X".
// Night Shift §3-4/§27: `role` distinguishes an employee's ONE current
// MAIN department from zero-or-more concurrently-open ADDITIONAL ones —
// added to this existing history table rather than a new one, per its
// own established "current = most recent open row" convention. Before
// this, the implicit assumption (enforced only by employeesController.
// assignDepartment always closing the prior open row) was "at most one
// open row per employee" — that assumption now only holds PER (employee,
// role) pair: at most one open MAIN row, and at most one open row per
// (employee, ADDITIONAL, department) — closing/opening logic lives in
// the controller, same as before, not a DB constraint (matching this
// table's existing convention).
enum DepartmentAssignmentRole {
  MAIN
  ADDITIONAL
}

model DepartmentAssignment {
  id         String    @id @default(cuid())
  department String
  role       DepartmentAssignmentRole @default(MAIN)
  startDate  DateTime  @default(now())
  endDate    DateTime? // set when this specific (employee, role[, department]) assignment ends; null = current

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  assignedById Int
  assignedBy   User @relation("DepartmentAssigner", fields: [assignedById], references: [id])

  @@index([employeeId])
  @@index([employeeId, role])
}

// ---------------------------------------------------------------------
// CountingAssignment — Inventory Counting spec §1-3: which department
// (and, more specifically, which area within it — e.g. "Aisle 4, Shelves
// 8-10") an employee is currently responsible for counting. Append-only
// history, same convention as DepartmentAssignment above — "current" is
// the most recent row for that employee (see
// countingAssignmentsController.getMyAssignment); no row at all means
// "use their plain department, no specific area yet" as the default.
//
// originalDepartment is a snapshot of Employee.department at assignment
// time, kept alongside assignedDepartment specifically so a CROSS-
// department assignment (originalDepartment !== assignedDepartment) is
// structurally detectable without a second lookup — that's exactly the
// case spec §3 requires Regional/Zone Manager verification for.
// verifiedById/verifiedAt stay null until that happens; a same-department
// assignment (just a more specific area within the employee's own
// department) never needs verification, so those fields are simply never
// populated for it — there is no separate "not applicable" state, the
// controller derives "needs verification" from
// originalDepartment !== assignedDepartment itself.
model CountingAssignment {
  id                 String   @id @default(cuid())
  originalDepartment String?
  assignedDepartment String
  countingArea       String? // e.g. "Aisle 4, Shelves 8-10"

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  assignedById Int
  assignedBy   User @relation("CountingAssignmentAssigner", fields: [assignedById], references: [id])

  verifiedById Int?
  verifiedBy   User?     @relation("CountingAssignmentVerifier", fields: [verifiedById], references: [id])
  verifiedAt   DateTime?

  createdAt  DateTime   @default(now())
  activities Activity[]

  @@index([employeeId])
}

// ---------------------------------------------------------------------
// CashierCleaningLog — one row per cashier per day, station-cleaning
// checklist. Deliberately NOT the same thing as Activity's SHELF_CLEANING
// category: this always means "clean the cashier station", never shelf/
// aisle/department cleaning, and only Morning-shift cashiers see this
// page at all (see cashierCleaningController.js). `items` is a JSON
// snapshot of the fixed checklist (label + checked) rather than a child
// table — the checklist is a small, fixed set of labels defined on the
// frontend, not independently queryable/reportable data.
// ---------------------------------------------------------------------
model CashierCleaningLog {
  id          String    @id @default(cuid())
  date        DateTime // the day this applies to; time part ignored
  items       Json // [{ label: string, checked: boolean }]
  completedAt DateTime?

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One log per cashier per day — same idempotent-upsert idiom as
  // AttendanceRecord.
  @@unique([employeeId, date])
  @@index([employeeId])
}

// ---------------------------------------------------------------------
// PriceReport — a cashier flagging a shelf-price vs. POS-system-price
// mismatch. Its own model, not ItemReport: no product/inventory link or
// stock side-effect, just two prices, an optional photo, and a route to
// the Supervisor for review (see priceReportsController.js — "send to
// the Supervisor" means the report is immediately visible to any
// Supervisor of this market, since no push-notification system exists
// anywhere in this app).
// ---------------------------------------------------------------------
model PriceReport {
  id          String         @id @default(cuid())
  productName String
  barcode     String?
  shelfPrice  Float
  systemPrice Float
  notes       String?
  photoUrl    String?
  shift       CashierShift? // the cashier's shift at the time of reporting
  status      ActivityStatus @default(PENDING)

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  marketId   String
  market     Market   @relation(fields: [marketId], references: [id])

  reportedAt DateTime @default(now())

  // Soft delete — same convention as ItemReport.deletedAt above.
  deletedAt DateTime?

  @@index([employeeId])
  @@index([marketId])
  @@index([reportedAt])
}

// The five produce items this feature supports — a fixed enum, not a
// Product catalog reference. Deliberately NOT reusing ItemReport: that
// model has a required, non-nullable productId hard-FK'd to a real
// market-scoped Product row and unconditionally decrements its
// stockQuantity in the same transaction — neither of those is meaningful
// for a fixed produce list with no catalog entry. This model mirrors
// PriceReport's shape instead (no product/inventory link, just fields +
// an optional photo + a route to the Supervisor for review) for the same
// reason PriceReport itself isn't ItemReport.
enum WastedItem {
  EGGS
  TOMATO
  POTATO
  CUCUMBER
  ONION
  // A produce item not on the fixed list — see otherItemName below for
  // the required free-text identifying it.
  OTHER
}

// ---------------------------------------------------------------------
// WastedOverallReport — a Worker reporting wasted produce (one of the
// WastedItem values) with a photo and a quantity. Routed automatically
// to the Supervisor of the reporting employee's market
// (Employee.marketId -> Market.supervisorId), who is notified via the
// existing Notification system (type WASTED_OVERALL) — the worker never
// picks a Supervisor themselves.
//
// Quantity unit varies by item: EGGS is counted in whole pieces
// (quantityCount), every other item (including OTHER) is weighed in kg
// (quantityKg) — exactly one of the two is set, enforced in validate.js.
// Both fields are nullable rather than one being repurposed, so existing
// rows (all kg-based, including pre-existing EGGS rows reported in kg
// before this change) are never reinterpreted: an old EGGS row keeps its
// original quantityKg value untouched, quantityCount stays null on it.
// ---------------------------------------------------------------------
model WastedOverallReport {
  id            String         @id @default(cuid())
  item          WastedItem
  quantityKg    Float? // > 0 when set, enforced in validate.js
  quantityCount Int? // > 0 when set (pieces, EGGS only going forward), enforced in validate.js
  // Required identifying text when item = OTHER (what the worker actually
  // wasted, since "Other" alone isn't useful) — null for every other item.
  otherItemName String?
  photoUrl      String?
  notes         String?
  status        ActivityStatus @default(PENDING)
  // Set on a Supervisor's REJECTED review — mirrors Activity/Task's own
  // rejectionReason shape.
  rejectionReason String?

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  marketId   String
  market     Market   @relation(fields: [marketId], references: [id])

  reviewedById Int?
  reviewedBy   User?     @relation("WastedOverallReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?

  reportedAt DateTime @default(now())

  @@index([employeeId])
  @@index([marketId])
  @@index([reportedAt])
}

// ---------------------------------------------------------------------
// Notification — a real feed, replacing what used to be just a
// TODO comment ("this toast is NOT a real notification system") in
// EmployeeWorkspace.jsx. See the NotificationType comment above for
// which concrete actions write one.
// ---------------------------------------------------------------------
// Recipient is EITHER an Employee OR a staff User, never both — same
// dual-nullable-FK pattern already used by Message's
// senderEmployeeId/senderUserId (enforced in the controller, not the DB,
// per that model's own comment on why). Added for WASTED_OVERALL: a
// Worker's report notifies their market's Supervisor, who is staff, not
// an Employee — every notification before this one only ever had an
// Employee recipient, so this couldn't be represented before.
model Notification {
  id    String           @id @default(cuid())
  type  NotificationType
  title String
  body  String
  read  Boolean          @default(false)

  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id])
  userId     Int?
  user       User?     @relation("NotificationRecipientUser", fields: [userId], references: [id])

  // Lets the frontend route to the right screen on tap without parsing
  // `body` — e.g. linkType "SUDDEN_TASK" + linkId = that task's id.
  linkType String?
  linkId   String?

  // Repair Pass §6 — soft delete: a user's own "Delete" always leaves the
  // row in place (never hard-deleted) so nothing here becomes an actual
  // audit-trail gap, but it's excluded from every recipient-facing query
  // (see notificationsController.js) the same way an Employee's
  // Communication history isn't literally erased by acknowledging it.
  deletedAt DateTime?

  createdAt DateTime @default(now())

  @@index([employeeId, read])
  @@index([userId, read])
}

// ---------------------------------------------------------------------
// Conversation — one per Market Group, one per Warnings channel, and one
// per Direct pair of employees. Group/Warnings are found-or-created in
// chatController.js (see the ConversationType comment above for why that
// can't be a bare DB constraint); Direct relies on the unique index below
// with participantAId/participantBId always stored in a consistent order
// (enforced in the controller) so the same pair never gets two rows.
// ---------------------------------------------------------------------
model Conversation {
  id   String           @id @default(cuid())
  type ConversationType

  // CUSTOM_GROUP only: the group's display name/photo (spec §6/§8/RM §1 —
  // renamable, persists for every member) and the staff account that
  // created it. The creator is automatically a group admin (see
  // ConversationMember.isAdmin) — but group-management authorization is
  // never "am I the creator", always "do I have an admin membership row",
  // so a promoted-then-un-promoted creator loses control exactly like
  // anyone else (see chatController.js's requireGroupAdmin).
  name        String?
  pictureUrl  String?
  createdById Int?
  createdBy   User?   @relation("ConversationCreator", fields: [createdById], references: [id])

  // Every non-CUSTOM_GROUP type is always scoped to exactly one market
  // (required). A CUSTOM_GROUP may instead be scoped to a whole zone
  // (marketId null, zoneId set — spec's "Regional/Zone Groups", e.g. a
  // Regional Manager's cross-market "Supervisors Group") or to one single
  // market (marketId set, same as before). Authorization for a
  // zone-scoped group is checked against zoneId instead of marketId (see
  // assertZoneAccess) — actual access, either way, is ultimately decided
  // by explicit ConversationMember rows, never implicit market/zone
  // membership (unlike MARKET_GROUP/WARNINGS, which stay implicit).
  marketId String?
  market   Market? @relation(fields: [marketId], references: [id])
  zoneId   Int?
  zone     Zone?   @relation(fields: [zoneId], references: [id])

  participantAId String? // DIRECT: one of the two Employees. SUPERVISOR_DIRECT: the Employee.
  participantA   Employee? @relation("ConversationParticipantA", fields: [participantAId], references: [id])
  participantBId String? // DIRECT only: the other Employee.
  participantB   Employee? @relation("ConversationParticipantB", fields: [participantBId], references: [id])
  // SUPERVISOR_DIRECT only: the Supervisor's User id (fixed at creation
  // to Market.supervisorId) — nullable and distinct from participantB
  // rather than repurposing it, since a DIRECT participant is always an
  // Employee and a SUPERVISOR_DIRECT one is always staff.
  staffParticipantId Int?
  staffParticipant   User? @relation("ConversationStaffParticipant", fields: [staffParticipantId], references: [id])
  // STAFF_DIRECT only: the second staff participant (staffParticipantId
  // above is the first) — same "two Employee slots" idea
  // participantA/participantB already use for DIRECT, just for the
  // staff-to-staff case (see ConversationType.STAFF_DIRECT's own
  // comment). Ordered consistently (lower User.id first) so the same
  // pair never gets two rows — enforced in
  // chatController.staffDirectPair(), not the DB.
  staffParticipantBId Int?
  staffParticipantB   User? @relation("ConversationStaffParticipantB", fields: [staffParticipantBId], references: [id])

  // RM_DIRECT only: true until the Regional Manager sends the first
  // message, after which it flips to false and stays false (the spec's
  // own rule — "once unlocked, remains available"). Enforced in
  // chatController.sendMessage, not just hidden in the UI. Meaningless
  // for every other ConversationType (defaults true but nothing reads it
  // for them).
  locked Boolean @default(true)

  // CUSTOM_GROUP only (Phase 3 §7-8): NORMAL is a standard group;
  // WARNING is an operational announcement group where only members
  // with ConversationMember.isAdmin = true may post (enforced in
  // chatController.sendMessage) — reuses the group-admin concept every
  // CUSTOM_GROUP already has instead of a new role/permission system.
  // Null for every other ConversationType.
  groupType GroupType?

  createdAt DateTime @default(now())

  messages Message[]
  reads    ConversationRead[]
  members  ConversationMember[]

  @@unique([marketId, type, participantAId, participantBId, staffParticipantId])
  @@unique([type, staffParticipantId, staffParticipantBId])
  @@index([marketId])
}

// CUSTOM_GROUP's purpose (Phase 3 §7) — both variants use the exact same
// Conversation/Message/ConversationMember tables, distinguished only by
// this field, never a separate NormalChat/WarningChat table.
enum GroupType {
  NORMAL
  WARNING
}

// ConversationMember — explicit membership for a CUSTOM_GROUP (spec
// §6/§7: add/remove members, view current members). Every other
// ConversationType determines "who's in it" a different way (implicit
// market-wide for MARKET_GROUP/WARNINGS, the two participant columns for
// DIRECT/SUPERVISOR_DIRECT/RM_DIRECT) — this table is only ever
// populated for CUSTOM_GROUP.
//
// A member is EITHER an Employee OR a staff User, never both (same
// dual-nullable-FK pattern as Message.sender — enforced in the
// controller, not the DB). Staff membership is what makes a Regional
// Manager's cross-market "Supervisors Group" possible: its members are
// User rows (each market's Supervisor/Overlooking account), not
// Employees at all.
//
// isAdmin — spec's own explicit rule: "do not make every Supervisor
// automatically the administrator of every group." A member controls the
// group (add/remove/promote/rename/change picture) only if THEIR OWN
// membership row has isAdmin=true — set true automatically for the
// creator's row at creation, and toggleable afterward by any other admin
// (see chatController.promoteGroupAdmin/demoteGroupAdmin). Being
// SUPERVISOR/REGIONAL_MANAGER by role is never sufficient on its own.
model ConversationMember {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  employeeId     String?
  employee       Employee?    @relation(fields: [employeeId], references: [id])
  userId         Int?
  user           User?        @relation("ConversationMemberUser", fields: [userId], references: [id])
  isAdmin        Boolean      @default(false)
  addedAt        DateTime     @default(now())

  @@unique([conversationId, employeeId])
  @@unique([conversationId, userId])
  @@index([conversationId])
}

// Message — sender is EITHER an Employee OR a staff User (Warnings
// broadcasts come from staff), never both; enforced in chatController.js,
// not at the DB layer, since Prisma has no native "exactly one of two
// nullable FKs" constraint.
model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  body     String // may be "" for an attachment-only message (image/file/audio/voice with no caption)
  imageUrl String? // existing image-attachment path, left as-is — see attachmentType for file/audio/voice

  // Generic attachment path added for file/audio/voice — image sending
  // already worked via imageUrl before this, so that field/UI is left
  // untouched rather than folded into this generic shape too.
  attachmentType        MessageAttachmentType?
  attachmentUrl         String?
  attachmentName        String? // original filename, for FILE
  attachmentSize        Int? // bytes
  attachmentDurationSec Int? // AUDIO / VOICE playback duration

  senderEmployeeId String?
  senderEmployee   Employee? @relation("MessageSenderEmployee", fields: [senderEmployeeId], references: [id])
  senderUserId     Int?
  senderUser       User?     @relation("MessageSenderUser", fields: [senderUserId], references: [id])

  // Self-relation for "reply to a specific message" — nullable, one level
  // (a reply to a reply still just points at that message directly, no
  // reply chain/thread tree; matches the spec's own "reply preview", not
  // full threading).
  replyToId String?
  replyTo   Message?  @relation("MessageReplyTo", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   Message[] @relation("MessageReplyTo")

  // Set when this message was created via Forward (spec §5) — a snapshot
  // of the ORIGINAL sender's name at forward time, not a live FK to the
  // source message/conversation. Deliberately a denormalized label, not
  // a relation: the forwarder and the recipient(s) of the forward may
  // not share access to the original conversation, so this never exposes
  // more than "who first sent this", and it stays stable even if the
  // original message is later edited or deleted. Never set together with
  // replyToId (forwarding and replying are different actions).
  forwardedFromSenderName String?

  // Set when the sender edits their own text message; the frontend shows
  // "Edited" whenever this is non-null rather than storing edit history.
  editedAt DateTime?
  // Soft-delete: body/attachments are blanked out by the controller when
  // this is set, but the row itself is kept (spec: "preserve appropriate
  // auditability for workplace communication") rather than hard-deleted.
  deletedAt DateTime?

  reactions MessageReaction[]
  mentions  MessageMention[]

  createdAt DateTime @default(now())

  @@index([conversationId, createdAt])
  @@index([replyToId])
}

// MessageReaction — one reaction per person per message; reacting again
// with the same emoji removes it, a different emoji replaces it (see
// chatController.reactToMessage). Sender is EITHER an Employee OR a
// staff User, same dual-nullable-FK pattern as Message.sender — enforced
// in the controller, and the two separate @@unique constraints below
// only ever bind on whichever side is non-null for a given row (a NULL
// employeeId never collides with another NULL employeeId in Postgres).
model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  emoji     String

  employeeId String?
  employee   Employee? @relation("MessageReactionEmployee", fields: [employeeId], references: [id])
  userId     Int?
  user       User?     @relation("MessageReactionUser", fields: [userId], references: [id])

  // Production Chat §13 — Management Recognition. True only when the
  // reactor was, at the moment of reacting, an authorized management
  // account (Supervisor/Overlooking/Regional Manager/Admin) reacting to an
  // Employee's message — verified server-side in
  // chatController.reactToMessage, never trusted from the request. A
  // Worker/Cashier reaction is always false; there is no client-supplied
  // way to set this true without that authorization check passing.
  isRecognition Boolean @default(false)

  createdAt DateTime @default(now())

  @@unique([messageId, employeeId])
  @@unique([messageId, userId])
  @@index([messageId])
}

// MessageMention — Production Chat §14-15. A real, structured mention:
// created only when the composer explicitly picks a candidate from
// listMentionCandidates (never parsed from raw "@text" server-side), and
// re-validated server-side against that same candidate set before being
// persisted (see chatController.isValidMentionTarget) — a display name is
// never used as the identifier. Target is EITHER an Employee OR a staff
// User, same dual-nullable-FK pattern as Message.sender/MessageReaction.
model MessageMention {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  employeeId String?
  employee   Employee? @relation("MessageMentionEmployee", fields: [employeeId], references: [id])
  userId     Int?
  user       User?     @relation("MessageMentionUser", fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@unique([messageId, employeeId])
  @@unique([messageId, userId])
  @@index([employeeId])
  @@index([userId])
}

// ConversationRead — one row per (conversation, employee OR staff user),
// tracking read position, and that owner's pin/mute preference for this
// conversation (their own "relationship to this conversation" row is the
// natural place for both, rather than a third table). Unread count =
// messages in that conversation created after lastReadAt (or every
// message, if no row exists yet — never opened). Phase 3: extended with
// the same dual-nullable-FK convention used everywhere else in this
// schema (see AttendanceRecord/Break) so Supervisor/Regional Manager
// unread tracking works too — exactly one of employeeId/staffUserId is
// set, enforced in chatController.js, not the DB.
model ConversationRead {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  employeeId     String?
  employee       Employee?    @relation(fields: [employeeId], references: [id])
  staffUserId    Int?
  staffUser      User?        @relation("StaffConversationReads", fields: [staffUserId], references: [id])
  lastReadAt     DateTime     @default(now())
  pinned         Boolean      @default(false)
  muted          Boolean      @default(false)

  @@unique([conversationId, employeeId])
  @@unique([conversationId, staffUserId])
}

// ImportantContact — Phase 3 §3-4: a staff user's own personal,
// reorderable shortlist of high-priority individual contacts (e.g. a
// Regional Manager pinning the CEO/Operations Manager/senior
// management). Purely organizational — favoriting a contact here does
// NOT grant any communication permission; the target must already be an
// authorized contact independent of this table (enforced where contacts
// are added, in chatController.js). Owner is always a staff account
// (only Supervisor/Regional Manager/Admin have this personal Chat
// organization per the spec); the contact target is dual-nullable
// (contactUserId OR contactEmployeeId) for flexibility, mirroring the
// rest of this schema's convention, even though every example in the
// spec (CEO, Operations Manager, senior management) is itself a staff
// account.
model ImportantContact {
  id               String    @id @default(cuid())
  ownerUserId      Int
  owner            User      @relation("ImportantContactOwner", fields: [ownerUserId], references: [id])
  contactUserId    Int?
  contactUser      User?     @relation("ImportantContactTargetUser", fields: [contactUserId], references: [id])
  contactEmployeeId String?
  contactEmployee  Employee? @relation("ImportantContactTargetEmployee", fields: [contactEmployeeId], references: [id])
  priority         Int       @default(0)
  createdAt        DateTime  @default(now())

  @@unique([ownerUserId, contactUserId])
  @@unique([ownerUserId, contactEmployeeId])
  @@index([ownerUserId])
}

// ---------------------------------------------------------------------
// Regional Manager market management — a Regional Manager's inspection
// record for one of their markets: a rating (1-10, historized, never
// overwritten), a management note, or formal feedback (a Warning or
// Recognition sent to the market's Supervisor). All three are distinct
// from Chat (see the spec: "Warning != Chat" — a Warning/Recognition is a
// formal management record, not a message bubble) and from each other,
// but can optionally belong to one MarketVisit so a single inspection's
// rating/notes/feedback show up together as one visit record instead of
// unrelated rows (spec §25).
// ---------------------------------------------------------------------
model MarketVisit {
  id       String @id @default(cuid())
  marketId String
  market   Market @relation(fields: [marketId], references: [id])

  // Admin Phase 3 — extends this existing model rather than creating a
  // second MarketVisit/AdminVisit table for the same concept (regional-
  // ManagerId was `Int` required; made nullable here). Exactly one of
  // regionalManagerId/adminUserId is ever set, same dual-nullable-FK
  // convention as everywhere else in this schema — a plain RM grouping
  // visit (unchanged behavior, marketManagementController.createMarketVisit)
  // sets regionalManagerId; a formal Admin Visit/Inspection
  // (adminAccountController's new lifecycle-aware endpoints) sets
  // adminUserId.
  regionalManagerId Int?
  regionalManager   User? @relation("MarketVisitRM", fields: [regionalManagerId], references: [id])
  adminUserId       Int?
  adminUser         User? @relation("MarketVisitAdmin", fields: [adminUserId], references: [id])

  visitDate DateTime @default(now())
  createdAt DateTime @default(now())

  // Admin-only fields below — meaningless (left at their defaults) for
  // an RM's plain grouping visit, which has no start/complete lifecycle
  // and isn't itself a "visit type": visitType/status only matter once
  // adminUserId is set. status defaults to COMPLETED so every existing
  // RM visit row (and any future plain grouping visit) is correctly
  // "done" rather than looking like a permanently-open Admin visit.
  visitType   MarketVisitType   @default(VISIT)
  status      MarketVisitStatus @default(COMPLETED)
  endedAt     DateTime?
  adminNotes  String?

  ratings   MarketRating[]
  notes     MarketNote[]
  feedbacks MarketFeedback[]

  @@index([marketId])
  @@index([regionalManagerId])
  @@index([adminUserId])
  @@index([status])
}

enum MarketVisitType {
  VISIT
  INSPECTION
}

enum MarketVisitStatus {
  STARTED
  COMPLETED
  CANCELLED
}

// ---------------------------------------------------------------------
// AuditLog — Admin Phase 3 §9-13: the ONE audit mechanism for every
// sensitive administrative action (no audit infrastructure existed
// before this — verified by inspection before adding this). Append-only
// by convention: no controller ever updates or deletes a row (see
// adminAuditController.js — it only ever creates/lists). previousValue/
// newValue/metadata are Json snapshots of NON-sensitive fields only —
// callers must never put a password/passwordHash/token in them (see
// utils/audit.js's own comment, the one place that writes this table).
model AuditLog {
  id         String      @id @default(cuid())
  actorUserId Int
  actor       User       @relation("AuditLogActor", fields: [actorUserId], references: [id])
  action      AuditAction
  targetType  String
  targetId    String?
  marketId    String?
  market      Market?     @relation(fields: [marketId], references: [id])
  zoneId      Int?
  zone        Zone?       @relation(fields: [zoneId], references: [id])
  reason      String?
  previousValue Json?
  newValue      Json?
  metadata      Json?
  createdAt   DateTime    @default(now())

  @@index([actorUserId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([marketId])
  @@index([zoneId])
  @@index([createdAt])
}

enum AuditAction {
  ROLE_CHANGED
  MARKET_ASSIGNMENT_CHANGED
  ZONE_ASSIGNMENT_CHANGED
  DEPARTMENT_ASSIGNMENT_CHANGED
  SHIFT_CHANGED
  EMPLOYEE_ID_CHANGED
  PASSWORD_RESET
  ACCOUNT_SUSPENDED
  ACCOUNT_BANNED
  ACCOUNT_REACTIVATED
  EMPLOYEE_PROMOTED
  STAFF_DEMOTED
  MARKET_VISIT_STARTED
  MARKET_VISIT_COMPLETED
  MARKET_VISIT_CANCELLED
  INSPECTION_STARTED
  INSPECTION_COMPLETED
  INSPECTION_CANCELLED
}

// A rating is never edited/overwritten — each one is its own row, so
// "current rating" (most recent) and "rating history/trend" both come
// from the same table with no separate audit log needed.
model MarketRating {
  id                String       @id @default(cuid())
  marketId          String
  market            Market       @relation(fields: [marketId], references: [id])
  regionalManagerId Int
  regionalManager   User         @relation("MarketRatingRM", fields: [regionalManagerId], references: [id])
  rating            Int // 1-10, enforced in validate.js
  notes             String?
  visitId           String?
  visit             MarketVisit? @relation(fields: [visitId], references: [id])
  createdAt         DateTime     @default(now())

  @@index([marketId, createdAt])
}

model MarketNote {
  id                String       @id @default(cuid())
  marketId          String
  market            Market       @relation(fields: [marketId], references: [id])
  regionalManagerId Int
  regionalManager   User         @relation("MarketNoteRM", fields: [regionalManagerId], references: [id])
  content           String
  category          String?
  visitId           String?
  visit             MarketVisit? @relation(fields: [visitId], references: [id])
  createdAt         DateTime     @default(now())

  @@index([marketId, createdAt])
}

enum MarketFeedbackType {
  WARNING
  RECOGNITION
}

enum MarketFeedbackPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

// A formal Warning or Recognition, always routed to the market's
// Supervisor (never the whole market's employees — same "the Supervisor
// is the single point of contact" convention already used by Wasted
// Overall reports). Delivered as a real staff Notification, not a Chat
// message (spec §21 — kept structurally separate from Message/
// Conversation entirely, not just styled differently).
model MarketFeedback {
  id                String                  @id @default(cuid())
  marketId          String
  market            Market                  @relation(fields: [marketId], references: [id])
  regionalManagerId Int
  regionalManager   User                    @relation("MarketFeedbackRM", fields: [regionalManagerId], references: [id])
  type              MarketFeedbackType
  title             String
  description       String
  category          String?
  priority          MarketFeedbackPriority  @default(NORMAL)
  photoUrl          String?
  visitId           String?
  visit             MarketVisit?            @relation(fields: [visitId], references: [id])
  createdAt         DateTime                @default(now())

  @@index([marketId, createdAt])
}

// ---------------------------------------------------------------------
// AttendanceAdjustmentRequest — an employee-submitted claim of extra
// hours worked, pending Supervisor review (spec §10-14). Deliberately
// its own model, not a repurposing of RequiredHoursAdjustment (that one
// is a staff-authoritative override, written instantly, no pending
// state) or AttendanceRecord.punishmentHours (staff-only, instant) —
// this is the opposite direction: the EMPLOYEE claims something, and it
// only becomes real once a Supervisor approves it. `type` is scoped to
// EXTRA_WORK today (the only thing an employee can submit per spec §10);
// the enum leaves room for a future staff-facing use without implying
// one exists yet. Deliberately NOT folded into the existing derived
// "extra hours" calculation (computeExtraHours in
// attendanceController.js) or the extra-hours-balance used for Earned
// Day Off — spec §15 explicitly keeps this independent of any
// hours-driven calculation until a final model is agreed; today this is
// purely a reviewable record, visible in Attendance History.
// ---------------------------------------------------------------------
enum AttendanceAdjustmentType {
  EXTRA_WORK
}

enum AttendanceAdjustmentStatus {
  PENDING
  APPROVED
  REJECTED
}

model AttendanceAdjustmentRequest {
  id         String                   @id @default(cuid())
  employeeId String
  employee   Employee                 @relation(fields: [employeeId], references: [id])
  date       DateTime // the day the extra hours were worked; time part ignored
  type       AttendanceAdjustmentType @default(EXTRA_WORK)
  hours      Float // > 0, enforced in validate.js
  reason     String?
  status     AttendanceAdjustmentStatus @default(PENDING)

  reviewedById Int?
  reviewedBy   User?     @relation("AttendanceAdjustmentReviewer", fields: [reviewedById], references: [id])
  reviewNote   String?
  reviewedAt   DateTime?

  createdAt DateTime @default(now())

  @@index([employeeId])
  @@index([status])
}

// ---------------------------------------------------------------------
// Total Sales — a market's total money sold in one 24-hour reporting day
// (RM/Supervisor spec §4-5). Supervisor-only to submit; Regional
// Manager-only to view (Admin can too, via the same staff-role gate every
// other market-scoped endpoint uses) — never exposed to employees or to
// the market's own Overlooking account. Deliberately append-only, never
// upserted: "preserve historical records rather than simply replacing
// previous reports" (spec's own words) — a market/day can accumulate more
// than one row (e.g. a corrected resubmission); the controller's
// day-view picks the most recent, but nothing is ever deleted/overwritten.
model TotalSalesReport {
  id       String @id @default(cuid())
  marketId String
  market   Market @relation(fields: [marketId], references: [id])

  date   DateTime // the 24-hour reporting day this covers; time part ignored
  amount Float // > 0, enforced in validate.js — never a fabricated/rounded estimate
  photoUrl String // evidence photo of the sales report, required

  submittedById Int
  submittedBy   User     @relation("TotalSalesSubmitter", fields: [submittedById], references: [id])
  submittedAt   DateTime @default(now())

  // Cleanup Phase §10 — this was permanently informational-only (no
  // status at all); a Regional Manager can now Approve/Reject it, same
  // ActivityStatus enum + reviewedBy/reviewedAt/rejectionReason shape
  // every other reviewable submission in this app already uses (Activity,
  // ItemReport...) rather than a near-duplicate status enum. DRAFT is
  // simply never assigned here — every report starts PENDING the moment
  // it's submitted, there is no draft concept for Total Sales.
  status         ActivityStatus @default(PENDING)
  reviewedById   Int?
  reviewedBy     User?          @relation("TotalSalesReviewer", fields: [reviewedById], references: [id])
  reviewedAt     DateTime?
  rejectionReason String?

  // Soft delete — Regional Manager/Admin only (see
  // totalSalesController.deleteTotalSalesReport), same convention as
  // Notification.deletedAt/ItemReport.deletedAt.
  deletedAt DateTime?

  @@index([marketId, date])
  @@index([marketId, status])
}

// ---------------------------------------------------------------------
// Card Sales — a per-shift card-count verification, separate from Total
// Sales (spec §6-8): three reporting periods per day (Morning/Afternoon/
// Night — labels only, not enforced clock times, per spec's own "should
// not be treated as rigid hardcoded times"), 1-2 evidence photos,
// submittable by either the market's Supervisor OR its Overlooking
// account. No unique constraint on (marketId, date, shift) for the same
// append-only-history reason as TotalSalesReport — a shift can be
// resubmitted/corrected; the controller's day-view always shows the most
// recent row per shift.
model CardSalesReport {
  id       String @id @default(cuid())
  marketId String
  market   Market @relation(fields: [marketId], references: [id])

  date  DateTime // the reporting day this shift belongs to; time part ignored
  shift CardSalesShift

  photoUrl  String // at least one evidence photo is required
  photoUrl2 String? // an optional second photo (spec: "up to two photos")

  submittedById Int
  submittedBy   User     @relation("CardSalesSubmitter", fields: [submittedById], references: [id])
  submittedAt   DateTime @default(now())

  // Soft delete — same convention as TotalSalesReport.deletedAt above.
  deletedAt DateTime?

  @@index([marketId, date])
}

enum CardSalesShift {
  MORNING
  AFTERNOON
  NIGHT
}

// CardSalesReminder — a Regional Manager nudging a market that hasn't
// finished today's Card Sales reporting (Market Activities §4). No status
// field, deliberately: "completed / still pending / not completed after
// the reminder" is never stored, it's derived at read time in
// cardSalesController.getZoneCardSalesSummary by comparing this row's
// sentAt (+ a 10-minute grace period) against the market's current
// CardSalesReport rows for the day — the same "no scheduler, derive
// on read" approach maintenanceScheduler.js's own comment already
// explains this app deliberately uses instead of a cron/job-queue
// dependency. Sending another reminder is just another row — the most
// recent one for a market/date is what the 10-minute window uses.
model CardSalesReminder {
  id       String @id @default(cuid())
  marketId String
  market   Market @relation(fields: [marketId], references: [id])

  date DateTime // the reporting day this reminder is about; time part ignored

  sentById Int
  sentBy   User     @relation("CardSalesReminderSender", fields: [sentById], references: [id])
  sentAt   DateTime @default(now())

  @@index([marketId, date])
}

// ---------------------------------------------------------------------
// UploadedFile — metadata for every file POST /api/uploads has ever
// accepted (filename, validated mimetype, who uploaded it). Two jobs:
//
// 1. Lets GET /api/uploads/:filename set a real, server-validated
//    Content-Type instead of trusting anything from the request.
// 2. Closes the "orphan window" between uploading a file and attaching
//    its URL to a real business record (e.g. a photo preview shown
//    before the activity/report it belongs to is actually saved) — see
//    utils/fileAuthorization.js's resolveFileOwner, which checks every
//    business-record table FIRST and only falls back to "the original
//    uploader" here if none of them reference this file yet. Once the
//    file is attached somewhere, that resource's own rules take over;
//    this row is simply never consulted for authorization again (kept
//    around anyway as a harmless audit trail of who uploaded what).
//
// Uploader is EITHER an Employee OR a staff User, never both — same
// dual-nullable-FK pattern used by Message.sender/ConversationMember.
model UploadedFile {
  filename   String   @id
  mimetype   String
  uploaderEmployeeId String?
  uploaderEmployee   Employee? @relation(fields: [uploaderEmployeeId], references: [id])
  uploaderUserId     Int?
  uploaderUser       User?     @relation(fields: [uploaderUserId], references: [id])
  createdAt  DateTime @default(now())

  @@index([uploaderEmployeeId])
  @@index([uploaderUserId])
}

// ---------------------------------------------------------------------
// Communication / CommunicationRecipient — "Warnings & Notifications":
// targeted internal communications from ADMIN/REGIONAL_MANAGER to a
// precisely-computed set of employees (role + Main/Additional department
// + market/zone/company scope). Deliberately NOT built on top of the
// existing Notification model above — Notification is a "one row IS one
// recipient's copy" shape (see createNotification/createNotificationForUser
// in utils/notifications.js), which has no way to represent "one
// communication, many recipients with independently tracked read/
// acknowledge/complete state" without changing the shape every existing
// caller (Sudden Task, Leave, Chat, Night Shift...) already relies on.
// Instead this is a genuinely new, reusable pair of models — and sending
// one ALSO writes one lightweight Notification per recipient (type
// COMMUNICATION, linkType "COMMUNICATION") so it shows up in the
// existing Notification Center/bell for free, with zero changes to that
// existing read/unread system. This is unrelated to ConversationType.
// WARNINGS (an existing per-market broadcast CHAT channel) — different
// feature, different data shape, deliberately not reused/renamed.
//
// MVP scoping decision (spec Rule 4 — do not overbuild): recipients are
// Employees only for now (WORKER/CASHIER/BUTCHER/EVERYONE-of-those) —
// every example in the spec targets Workers, and staff-as-recipient
// would need the same dual-nullable-FK shape Notification already uses;
// adding that later is a small additive migration, not a redesign.
// ---------------------------------------------------------------------

enum CommunicationType {
  ANNOUNCEMENT
  WARNING
  TASK
  INFORMATION
}

enum CommunicationCategory {
  STOCK_CHECK
  COUNTING
  CLEANING
  PRICE
  LABEL
  EXPIRY
  INVENTORY
  GENERAL
}

enum CommunicationPriority {
  NORMAL
  IMPORTANT
  HIGH
  URGENT
}

// How the recipient set's geographic boundary is expressed. Resolved
// against the REAL Market->Zone relationship at send time (never trusted
// from the frontend) — see communicationTargeting.js.
enum CommunicationScopeType {
  MARKET
  ZONE
  ALL_MARKETS
  // Verification pass §1 — a single, specifically-named Supervisor
  // (Communication.targetSupervisorId), not a computed audience. Only
  // ever usable by a REGIONAL_MANAGER/ADMIN sender, and only ever
  // resolves to a Supervisor already inside the sender's real
  // authorized-contact scope (communicationTargeting.authorizeTargeting
  // reuses the exact same authorizedStaffContactsFor check the RM<->
  // Supervisor chat feature already relies on).
  SPECIFIC_SUPERVISOR
}

// Deliberately EmployeeRole's own real values, never a parallel enum —
// spec §7/§34: "use only roles that actually exist." EVERYONE means
// "every real EmployeeRole", not staff.
enum CommunicationTargetRole {
  WORKER
  CASHIER
  BUTCHER
  EVERYONE
}

enum CommunicationActionType {
  INFORMATIONAL
  ACKNOWLEDGEMENT
  COMPLETION
}

// Per-recipient progress (spec §16-17) — not every value is reachable
// for every actionType (an INFORMATIONAL communication only ever moves
// UNREAD -> READ; ACKNOWLEDGED/IN_PROGRESS/COMPLETED are reachable only
// when the communication's actionType calls for them).
enum CommunicationRecipientStatus {
  UNREAD
  READ
  ACKNOWLEDGED
  IN_PROGRESS
  COMPLETED
}

model Communication {
  id String @id @default(cuid())

  senderId Int
  sender   User @relation("CommunicationSender", fields: [senderId], references: [id])
  // Display-only snapshot (spec §5) — senderId + the LIVE User row remain
  // the only source of truth for authorization; these three fields exist
  // purely so history/detail screens don't misrepresent who a long-gone
  // or since-reassigned sender was AT THE TIME they sent this.
  senderNameSnapshot String
  senderRoleSnapshot StaffRole
  // The zone's human-readable NUMBER ("Zone 2"), i.e. Zone.number — NOT
  // Zone.id. Deliberately a plain snapshot int rather than a Zone
  // relation, since a Regional Manager's zone for THIS communication is
  // "which zone did they send as," fixed forever, not "whatever zone(s)
  // they manage now."
  senderZoneSnapshot Int?

  type     CommunicationType
  category CommunicationCategory
  title    String
  message  String
  priority CommunicationPriority @default(NORMAL)

  scopeType CommunicationScopeType
  zoneId    Int?
  zone      Zone?   @relation(fields: [zoneId], references: [id])
  marketId  String?
  market    Market? @relation(fields: [marketId], references: [id])
  // Verification pass §1 — only set (and only meaningful) when
  // scopeType = SPECIFIC_SUPERVISOR: a Regional Manager targeting exactly
  // one named Supervisor, not a computed bulk audience. targetRole/
  // targetDepartment/marketId/zoneId are all irrelevant for this scope
  // (enforced in communicationTargetingSchema/authorizeTargeting, not
  // just left ambiguous) — the recipient set is always exactly this one
  // staff account.
  targetSupervisorId Int?
  targetSupervisor   User? @relation("CommunicationTargetSupervisor", fields: [targetSupervisorId], references: [id])

  targetRole CommunicationTargetRole?
  // null = "All Departments"; a plain department-name string otherwise,
  // matched against DepartmentAssignment.department (MAIN or ADDITIONAL,
  // currently-open rows) — same plain-string convention used everywhere
  // else in this schema (Employee.department, NightShiftTaskDefinition.
  // departmentRestriction), never a separate Department table/id.
  targetDepartment String?

  deadline   DateTime?
  actionType CommunicationActionType @default(INFORMATIONAL)

  // Denormalized snapshot count (spec §32 history list) — set once at
  // send time from the real recipient rows just created, so listing sent
  // communications never needs an extra count() per row. The
  // CommunicationRecipient rows themselves remain the actual source of
  // truth for every other count (read/acknowledged/completed).
  recipientCount Int @default(0)

  // Optional client-generated idempotency key (spec §41) — a real unique
  // constraint, so a double-click or a retried request after a timeout
  // can't ever create two Communication rows for the same intended send;
  // the controller catches the unique-violation and returns the
  // already-created row instead of erroring. Nullable/unique (not a
  // plain unique-per-value column) because most callers won't send one
  // and Postgres treats every NULL as distinct, so omitting it never
  // collides with another omitted one.
  clientRequestId String? @unique

  createdAt DateTime @default(now())

  recipients CommunicationRecipient[]

  @@index([senderId, createdAt])
  @@index([zoneId])
  @@index([marketId])
}

model CommunicationRecipient {
  id              String        @id @default(cuid())
  communicationId String
  communication   Communication @relation(fields: [communicationId], references: [id])

  // Verification pass §1 — dual-nullable, exactly one ever set, same
  // pattern Notification/Message/ConversationMember already use
  // elsewhere in this schema. Every EXISTING recipient row (bulk
  // employee targeting) keeps employeeId set / userId null; a
  // SPECIFIC_SUPERVISOR send is the one new case with userId set /
  // employeeId null. Enforced in the controller, not a DB CHECK
  // constraint, matching this codebase's existing convention for every
  // other dual-owner model.
  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id])
  userId     Int?
  user       User?     @relation("CommunicationRecipientUser", fields: [userId], references: [id])

  status         CommunicationRecipientStatus @default(UNREAD)
  readAt         DateTime?
  acknowledgedAt DateTime?
  startedAt      DateTime?
  completedAt    DateTime?

  // Structured result values for a COMPLETION-type communication (spec
  // §19-20's "White Monster Count" example) — free-shape JSON rather
  // than fixed columns, since the fields a response needs are defined by
  // the sender's message content, not by this schema. An optional note
  // lives inside this same object rather than as its own column.
  response Json?

  createdAt DateTime @default(now())

  // One recipient row per (communication, employee/user) — the actual
  // guarantee behind "no duplicate recipient entries" (spec §40). Two
  // separate unique indexes (not one compound one) because Postgres
  // treats every NULL as distinct — a single @@unique([communicationId,
  // employeeId, userId]) would NOT stop two staff rows (both employeeId
  // NULL) for the same communication from colliding.
  @@unique([communicationId, employeeId])
  @@unique([communicationId, userId])
  @@index([employeeId, status])
  @@index([userId, status])
  @@index([communicationId])
}

// ---------------------------------------------------------------------
// MarketProblem — Repair Pass §4: a physical/technical market issue
// (freezer down, broken door, etc), reported by a Supervisor/Overlooking
// for their own market. Previously entirely mock/in-memory data
// (Frontend's data/supervisorMockData.js) with no backend model at all —
// this is the real replacement, same OPEN -> IN_PROGRESS -> RESOLVED
// lifecycle the mock already modeled, now actually persisted so a
// resolved problem staying off the active view survives a refresh.
// ---------------------------------------------------------------------
enum MarketProblemStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

model MarketProblem {
  id       String @id @default(cuid())
  marketId String
  market   Market @relation(fields: [marketId], references: [id])

  // Free text, not an enum — matches the frontend's existing
  // PROBLEM_TYPES list of full descriptive labels (e.g. "Freezer not
  // working"), including an explicit "Other market problem" catch-all,
  // so no problem type is ever rejected for not fitting a fixed set.
  problemType String
  location    String
  description String
  photoUrl    String?
  status      MarketProblemStatus @default(OPEN)
  // Set the moment status becomes RESOLVED, cleared if moved back off it
  // (correcting a mistaken resolve) — this is what the active-vs-history
  // query actually filters on, not just the status label.
  resolvedAt DateTime?

  reportedByUserId Int
  reportedByUser   User @relation("MarketProblemReporter", fields: [reportedByUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Soft delete — a genuinely unwanted/duplicate report can be removed
  // from both Active and History (see
  // marketProblemsController.deleteMarketProblem), same convention as
  // Notification.deletedAt — the row is kept, never hard-deleted.
  deletedAt DateTime?

  @@index([marketId, status])
  @@index([marketId, resolvedAt])
}
