# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string.
DATABASE_URL="postgresql://user:password@localhost:5432/teammart?schema=public"

# Long random string used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-string"

# Port the API listens on.
PORT=4000

# development | production
NODE_ENV=development

# Comma-separated allowlist of origins allowed to call this API
# (e.g. "https://app.teammart.com,https://admin.teammart.com"). Leave
# unset in development — the API allows any origin so the Vite dev server
# works with zero setup. Set this before deploying to production.
CORS_ORIGIN=

# Base URL uploaded-file links are built from (e.g.
# "https://api.teammart.com"). Leave unset in development — it falls
# back to the request's own protocol+host, which is correct for
# localhost. Set this in production if the API sits behind a proxy/load
# balancer that changes what the app sees as its own host.
PUBLIC_BASE_URL=

# Admin Phase 1 §2 — real Admin account provisioning (npm run
# admin:provision). Only the two *_PASSWORD variables are required; name/
# email fall back to the two intended accounts if unset. Never commit
# real values here — set them in your local .env or your deployment
# platform's secret store only.
ADMIN_1_NAME="Raxand ENVy"
ADMIN_1_EMAIL="raxand.envy@teammart.admin"
ADMIN_1_PASSWORD=
ADMIN_2_NAME="MoNReaL pride"
ADMIN_2_EMAIL="monreal.pride@teammart.admin"
ADMIN_2_PASSWORD=

# Optional: a separate database for `npm test` (backend/test/security)
# to use instead of DATABASE_URL, e.g.
#   postgresql://user:password@localhost:5432/teammart_test
# Leave unset to run the test suite against your normal dev database —
# it's safe to do so (every row it creates is tagged and deleted again),
# but a dedicated test database gives real isolation if you'd prefer it.
TEST_DATABASE_URL=
