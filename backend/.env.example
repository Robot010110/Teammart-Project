# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string.
DATABASE_URL="postgresql://user:password@localhost:5432/teammart?schema=public"

# Long random string used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-string"

# Port the API listens on.
PORT=4000

# development | production
NODE_ENV=development

# Comma-separated allowlist of origins allowed to call this API
# (e.g. "https://app.teammart.com,https://admin.teammart.com"). Leave
# unset in development — the API allows any origin so the Vite dev server
# works with zero setup. Set this before deploying to production.
CORS_ORIGIN=
